<Application x:Class="Yesify.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Yesify"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- explicit mark: a rounded tile with the E cut out of it (vector, so it stays crisp and the background shows through) -->
            <BooleanToVisibilityConverter x:Key="ExplicitVis" />
            <Style x:Key="ExplicitMark" TargetType="Path">
                <Setter Property="Width" Value="12.5" />
                <Setter Property="Height" Value="12.5" />
                <Setter Property="Stretch" Value="None" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="ToolTip" Value="Explicit" />
                <Setter Property="Fill" Value="{DynamicResource InactiveIconBrush}" />
                <Setter Property="Data">
                    <Setter.Value>
                        <GeometryGroup FillRule="EvenOdd">
                            <RectangleGeometry Rect="0,0,12.5,12.5" RadiusX="2.9" RadiusY="2.9" />
                            <PathGeometry Figures="M4.1,3 H8.5 V4.45 H5.7 V5.55 H8.15 V6.95 H5.7 V8.05 H8.5 V9.5 H4.1 Z" />
                        </GeometryGroup>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Palette -->
            <Color x:Key="AccentColor">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="WindowBrush" Color="#FF0A0A0C" />
            <SolidColorBrush x:Key="PanelBrush" Color="#FF141418" />
            <SolidColorBrush x:Key="RaisedBrush" Color="#FF1E1E24" />
            <SolidColorBrush x:Key="HoverBrush" Color="#FF26262E" />
            <SolidColorBrush x:Key="SelectedBrush" Color="#FF2C2C33" />
            <SolidColorBrush x:Key="TextBrush" Color="#FFF2F2F5" />
            <SolidColorBrush x:Key="SubtleTextBrush" Color="#FF9A9AA6" />
            <SolidColorBrush x:Key="FaintTextBrush" Color="#FF7A7A86" />
            <SolidColorBrush x:Key="DividerBrush" Color="#FF24242B" />
            <!-- Theme colors (set by Theme.Apply). -->
            <SolidColorBrush x:Key="InactiveIconBrush" Color="#FF9A9AA6" />
            <SolidColorBrush x:Key="LogoBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="LogoForegroundBrush" Color="#FF0A0A0C" />
            <SolidColorBrush x:Key="ToastBrush" Color="#F02C2C33" />
            <SolidColorBrush x:Key="SettingsCardBrush" Color="#FF1A1A20" />
            <SolidColorBrush x:Key="SwitchKnobOnBrush" Color="#FF101016" />
            <SolidColorBrush x:Key="PlayButtonBrush" Color="#FFF2F2F5" />
            <SolidColorBrush x:Key="PlayButtonBorderBrush" Color="#00000000" />
            <SolidColorBrush x:Key="PlayGlyphBrush" Color="#FF0A0A0C" />
            <SolidColorBrush x:Key="MenuBrush" Color="#FF1E1E24" />
            <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FF3A3A44" />
            <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FF5A5A66" />
            <SolidColorBrush x:Key="ScrollThumbBorderBrush" Color="#00000000" />
            <LinearGradientBrush x:Key="LikedTileBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF4A4A55" Offset="0" />
                <GradientStop Color="#FF26262C" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="PanelBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassChipBrush" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="PlayerBarBrush" Color="#5906070C" />
            <LinearGradientBrush x:Key="MainPanelBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF26262C" Offset="0" />
                <GradientStop Color="#FF141418" Offset="0.45" />
            </LinearGradientBrush>

            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- Converters -->
            <local:BoolToVisibilityConverter x:Key="BoolToVis" />
            <local:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
            <local:NullToVisibilityConverter x:Key="NullToVis" />
            <local:NullToVisibilityConverter x:Key="InvNullToVis" Invert="True" />
            <local:PlayGlyphConverter x:Key="PlayGlyph" />
            <local:RepeatGlyphConverter x:Key="RepeatGlyph" />
            <local:ActiveBrushConverter x:Key="ActiveBrush" />
            <local:SameObjectConverter x:Key="SameObject" />
            <local:SliderFillConverter x:Key="SliderFill" />
            <local:SidebarLabelOpacityConverter x:Key="SidebarLabelOpacity" />
            <local:PercentConverter x:Key="Percent" />
            <local:ZeroToVisibilityConverter x:Key="ZeroToVis" />
            <local:CountToVisibilityConverter x:Key="CountToVis" />
            <local:TabBackgroundConverter x:Key="TabBackground" />

            <!-- A glyph string as a bold vector icon (see Icon.cs). -->
            <DataTemplate x:Key="IconGlyph">
                <local:Icon Glyph="{Binding}" />
            </DataTemplate>
            <local:GlyphTemplateSelector x:Key="IconGlyphSelector" Glyph="{StaticResource IconGlyph}" />
            <local:EqualsConverter x:Key="Equals" />
            <local:PresetBrushConverter x:Key="PresetBrush" />
            <local:VolumeGlyphConverter x:Key="VolumeGlyph" />

            <!-- Flat icon / text button -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="ContentTemplateSelector" Value="{StaticResource IconGlyphSelector}" />
                <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Like toggle; DataContext must be a Track -->
            <Style x:Key="HeartButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Content" Value="&#xEB51;" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="ToolTip" Value="Add to Liked Songs" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLiked}" Value="True">
                        <Setter Property="Content" Value="&#xEB52;" />
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="ToolTip" Value="Remove from Liked Songs" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Picture-in-picture icon for "open miniplayer"; takes the button's color. -->
            <DataTemplate x:Key="MiniPlayerGlyph">
                <Grid Width="16" Height="13">
                    <Rectangle StrokeThickness="1.8" RadiusX="3" RadiusY="3"
                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <Rectangle Width="7" Height="5" RadiusX="1" RadiusY="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2.5,2.5"
                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Grid>
            </DataTemplate>

            <!-- On/off switch (CheckBox): the knob slides across and the track fades to white; same size both ways. -->
            <Style x:Key="SwitchBox" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" />
                                <Border x:Name="Track" Grid.Column="1" Width="40" Height="24" CornerRadius="12" Margin="10,0,0,0"
                                        BorderThickness="1" BorderBrush="#33FFFFFF">
                                    <Border.Background>
                                        <SolidColorBrush Color="#33FFFFFF" />
                                    </Border.Background>
                                    <Ellipse x:Name="Knob" Width="18" Height="18" HorizontalAlignment="Left" Margin="2,0,0,0" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="#FFFFFFFF" />
                                        </Ellipse.Fill>
                                        <Ellipse.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform />
                                                <TranslateTransform />
                                            </TransformGroup>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                                 To="16" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#F2FFFFFF" Duration="0:0:0.22" />
                                                <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                                                                To="#FF101016" Duration="0:0:0.22" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                                 To="0" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#33FFFFFF" Duration="0:0:0.22" />
                                                <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                                                                To="#FFFFFFFF" Duration="0:0:0.22" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter TargetName="Track" Property="BorderBrush" Value="#59FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Round accent play button -->
            <!-- Play / pause: a frosted-glass disc with a white icon. -->
            <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Foreground" Value="{DynamicResource PlayGlyphBrush}" />
                <Setter Property="Background" Value="{DynamicResource PlayButtonBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PlayButtonBorderBrush}" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Body" RenderTransformOrigin="0.5,0.5">
                                <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                                <!-- soft highlight on top, like light catching glass -->
                                <Ellipse x:Name="Shine" Opacity="0" IsHitTestVisible="False">
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#33FFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="0.7" />
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Body" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="Shine" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Body" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccentPlayButton" TargetType="Button" BasedOn="{StaticResource PlayButton}">
                <Setter Property="Width" Value="52" />
                <Setter Property="Height" Value="52" />
                <Setter Property="FontSize" Value="20" />
            </Style>

            <!-- Liner-style glass chip: a rounded square of frosted white, for hero actions (shuffle, save, more). -->
            <Style x:Key="GlassIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource GlassChipBrush}" />
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="40" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                                    CornerRadius="10" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Liner-style segmented bar item (player bar: lyrics, queue, cinema, mini). Tag=True marks it on. -->
            <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="32" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="9" RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RaisedBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                </DataTrigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Filter chip (Library: All / Playlists / Albums). Tag=True is the selected one: light, dark text. -->
            <Style x:Key="ChipButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource GlassChipBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E6FFFFFF" />
                                    <Setter Property="Foreground" Value="#FF0A0A0E" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Pill text button -->
            <Style x:Key="PillButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="18,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccentPillButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="#FF0A0A0C" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sidebar nav button -->
            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RaisedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Window caption buttons -->
            <Style x:Key="CaptionButton" TargetType="Button">
                <Setter Property="ContentTemplateSelector" Value="{StaticResource IconGlyphSelector}" />
                <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter TargetName="Bd" Property="Background" Value="#FFC42B1C" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Text input -->
            <Style x:Key="InputBox" TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Height" Value="40" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                    BorderThickness="1" BorderBrush="Transparent">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FaintTextBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Flat slider used for seek + volume: rail, fill and knob drawn from the value; SliderDrag handles input. -->
            <Style x:Key="ThinSlider" TargetType="Slider">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="local:SliderDrag.IsEnabled" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid x:Name="Root" Background="Transparent">
                                <Border Height="4" CornerRadius="2" Background="#5AFFFFFF" VerticalAlignment="Center" />
                                <Border x:Name="Fill" Height="4" CornerRadius="2" Background="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource SliderFill}">
                                            <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="ActualWidth" ElementName="Root" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                                <Ellipse x:Name="Knob" Width="12" Height="12" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Opacity="0" IsHitTestVisible="False">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform>
                                            <TranslateTransform.X>
                                                <MultiBinding Converter="{StaticResource SliderFill}" ConverterParameter="12">
                                                    <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                                    <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                                    <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                                    <Binding Path="ActualWidth" ElementName="Root" />
                                                </MultiBinding>
                                            </TranslateTransform.X>
                                        </TranslateTransform>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Knob" Property="Opacity" Value="1" />
                                    <Setter TargetName="Fill" Property="Background" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Slim scrollbars: a frosted pill (brushes set by Theme.Apply). -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="10" />
                <Setter Property="MinWidth" Value="10" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="T" CornerRadius="2" Margin="4,10" Background="{DynamicResource ScrollThumbBrush}" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="T" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                                                            <Setter TargetName="T" Property="Margin" Value="2.5,10" />
                                                            <Setter TargetName="T" Property="CornerRadius" Value="3" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="T" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                                                            <Setter TargetName="T" Property="Margin" Value="2.5,10" />
                                                            <Setter TargetName="T" Property="CornerRadius" Value="3" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Height" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Tooltips: a small dark pill instead of the Windows default box. -->
            <Style TargetType="ToolTip">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="HasDropShadow" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="#F21A1A20" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" Padding="9,5">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Menus: near-opaque dark (glass stays readable), with submenus ("Add to Playlist ▸"). -->
            <!-- Menus open without Windows' own slide/fade; the menu below fades in by itself once it's laid out. -->
            <PopupAnimation x:Key="{x:Static SystemParameters.MenuPopupAnimationKey}">None</PopupAnimation>
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="{DynamicResource MenuBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                <Setter Property="MinWidth" Value="190" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Grid x:Name="Root" Opacity="0" RenderTransformOrigin="0,0">
                                <Grid.RenderTransform>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                </Grid.RenderTransform>
                                <Border local:Frost.Enabled="True" CornerRadius="8" />
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsOpen" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- starts a moment late: the items and the frost are in place by then, so nothing flickers -->
                                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.03" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.97" To="1" BeginTime="0:0:0.03" Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.97" To="1" BeginTime="0:0:0.03" Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Grid>
                                <Border x:Name="Bd" Padding="12,7" CornerRadius="5" Background="Transparent">
                                    <Grid>
                                        <ContentPresenter ContentSource="Header" Margin="0,0,22,0" RecognizesAccessKey="False" />
                                        <TextBlock x:Name="Arrow" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Visibility="Collapsed"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
                                    </Grid>
                                </Border>
                                <!-- Overlaps the menu slightly: a gap would close it as the pointer crosses over. -->
                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" HorizontalOffset="-3" VerticalOffset="-5"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                    <Grid MinWidth="190">
                                        <Border local:Frost.Enabled="True" CornerRadius="8" />
                                        <Border Background="{DynamicResource MenuBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                </Trigger>
                                <Trigger Property="Role" Value="SubmenuHeader">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" Margin="8,4" Background="{DynamicResource DividerBrush}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sidebar toggle icon: a window with a sidebar. Takes the button's colour. -->
            <DataTemplate x:Key="SidebarGlyph">
                <Grid Width="17" Height="14">
                    <Rectangle StrokeThickness="1.8" RadiusX="3" RadiusY="3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <Rectangle Width="1.8" HorizontalAlignment="Left" Margin="5.5,1,0,1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Grid>
            </DataTemplate>

            <!-- Sidebar entry; Tag=True marks the current view. -->
            <Style x:Key="SideNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Rectangular text field (playlist title / description). -->
            <Style x:Key="FieldBox" TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Auto" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#80FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

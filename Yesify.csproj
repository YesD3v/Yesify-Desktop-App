<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>yesify.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Keep the .NET runtime lean: Yesify spends most of its life playing audio in the tray. -->
  <PropertyGroup>
    <!-- No background GC thread or its extra heap reservations. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Skip profile-guided JIT instrumentation and runtime event tracing. -->
    <TieredPGO>false</TieredPGO>
    <EventSourceSupport>false</EventSourceSupport>
    <!-- Precompiled code is mapped from the exe (shared, pageable) instead of JIT-compiled into private memory. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- Have the GC compact more eagerly and hand memory back to Windows (0-9, higher = tighter). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <!-- Home's visualizer, drawn by the graphics card: compiled from Shaders/AudioRing.fx (see the commands there). -->
    <Resource Include="Shaders\*.ps" />
  </ItemGroup>

  <!-- For the updater (Services/Updater.cs): the git commit a build comes from, and for builds from source
       (not the published single-file exe) the folder to pull and rebuild in. -->
  <Target Name="YesifyBuildInfo" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-parse HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" EchoOff="true"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_YesifyGitOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_YesifyGitExit" />
    </Exec>
    <PropertyGroup>
      <_YesifyCommit Condition="'$(_YesifyGitExit)' == '0'">$(_YesifyGitOutput)</_YesifyCommit>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>YesifyCommit</_Parameter1>
        <_Parameter2>$(_YesifyCommit)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(PublishSingleFile)' != 'true'">
        <_Parameter1>YesifyProjectDir</_Parameter1>
        <_Parameter2>$(MSBuildProjectDirectory)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="YoutubeExplode" Version="6.6.2" />
  </ItemGroup>

</Project>

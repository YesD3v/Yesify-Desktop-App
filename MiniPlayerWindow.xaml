<Window x:Class="Yesify.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Yesify"
        Title="Yesify miniplayer" Width="320" Height="320" MinWidth="220" MinHeight="96" MaxWidth="1000" MaxHeight="1000"
        WindowStyle="None" ResizeMode="CanResize" Topmost="True" ShowInTaskbar="False"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Colors come from the album cover (see code-behind). -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop x:Name="StopA" Color="#FF26262C" Offset="0" />
            <GradientStop x:Name="StopB" Color="#FF141418" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid x:Name="Root" Background="Transparent" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <!-- Darken toward the bottom so text stays readable on bright covers. -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0.3" />
                    <GradientStop Color="#80000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Rows/columns are rearranged in code: cover on top (tall) or on the left (wide). -->
        <Grid x:Name="Body" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="CoverRow" Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CoverColumn" Width="*" />
                <ColumnDefinition x:Name="InfoColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- cover: sized in code to the largest square that fits -->
            <Grid x:Name="CoverHost" SizeChanged="CoverHost_SizeChanged">
                <Border x:Name="Cover" CornerRadius="8" Background="#33FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MouseLeftButtonDown="Cover_MouseLeftButtonDown" ToolTip="Double-click to play / pause">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" />
                    </Border.Effect>
                    <Grid>
                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="#80FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border CornerRadius="8" local:AsyncImage.BackgroundUrl="{Binding CurrentTrack.ImageUrl}" local:AsyncImage.Width="640" />
                    </Grid>
                </Border>
            </Grid>

            <StackPanel x:Name="Info" Grid.Row="1">
                <TextBlock x:Name="TitleText" Margin="0,14,0,0" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                           Text="{Binding CurrentTrack.Title, FallbackValue='Nothing playing', TargetNullValue='Nothing playing'}" />
                <TextBlock x:Name="ArtistText" Margin="0,2,0,0" FontSize="13" Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis"
                           Text="{Binding CurrentTrack.Artist}" />

                <!-- progress -->
                <Slider x:Name="SeekBar" Margin="0,10,0,0" Style="{StaticResource ThinSlider}" Minimum="0"
                        Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}"
                        PreviewMouseLeftButtonDown="SeekBar_MouseDown" PreviewMouseLeftButtonUp="SeekBar_MouseUp" />
                <Grid x:Name="Times" Margin="0,2,0,0">
                    <TextBlock Text="{Binding PositionText}" FontSize="11" Foreground="#B3FFFFFF" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding DurationText}" FontSize="11" Foreground="#B3FFFFFF" HorizontalAlignment="Right" />
                </Grid>

                <!-- controls (only when there's room) -->
                <Grid x:Name="Controls" Margin="0,6,0,0">
                    <Button Style="{StaticResource HeartButton}" DataContext="{Binding CurrentTrack}" HorizontalAlignment="Left"
                            Command="{Binding DataContext.ToggleLikeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" Foreground="#E6FFFFFF" Command="{Binding PreviousCommand}" ToolTip="Previous" />
                        <Button Style="{StaticResource PlayButton}" Margin="10,0" Content="{Binding IsPlaying, Converter={StaticResource PlayGlyph}}"
                                Command="{Binding TogglePlayCommand}" ToolTip="Play / Pause" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" Foreground="#E6FFFFFF" Command="{Binding NextCommand}" ToolTip="Next" />
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" FontSize="14" Foreground="#CCFFFFFF"
                            Content="{Binding Repeat, Converter={StaticResource RepeatGlyph}}" Command="{Binding CycleRepeatCommand}" ToolTip="Repeat" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- corner buttons, shown on hover -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Foreground="White" Background="#59000000"
                    Content="&#xE740;" Command="{Binding OpenFullPlayerCommand}" ToolTip="Open full player" />
            <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Foreground="White" Background="#59000000" Margin="4,0,0,0"
                    Content="&#xE8BB;" Click="Close_Click" ToolTip="Close miniplayer (music keeps playing)" />
        </StackPanel>
    </Grid>
</Window>

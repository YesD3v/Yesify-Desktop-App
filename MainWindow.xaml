<Window x:Class="Yesify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Yesify"
        xmlns:m="clr-namespace:Yesify.Models"
        Title="Yesify" Width="1280" Height="800" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Song row container (hover / selected highlight, double-click to play). -->
        <Style x:Key="TrackRowStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <EventSetter Event="MouseDoubleClick" Handler="TrackRow_DoubleClick" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header row: no highlight, never selected. -->
        <Style x:Key="PlainRowStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <local:RowStyleSelector x:Key="TrackRows" Default="{StaticResource TrackRowStyle}" Plain="{StaticResource PlainRowStyle}" />

        <!-- Queue panel row -->
        <DataTemplate x:Key="QueueRow" DataType="{x:Type m:QueueItem}">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform />
                        <TranslateTransform />
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Play" Click="QueueMenuPlay_Click" />
                        <MenuItem Header="Remove from queue" Click="QueueMenuRemove_Click">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source}" Value="Queued">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="4" Background="{DynamicResource RaisedBrush}" ClipToBounds="True">
                        <Image local:AsyncImage.Url="{Binding Track.ImageUrl}" local:AsyncImage.Width="80" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Track.Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Track.Artist}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RaisedBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
            <Setter Property="Margin" Value="6,18,0,8" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ============================================================ glass backdrop
             Artwork decoded tiny and stretched (reads as a blur), tinted with its own vivid colors. -->
        <Grid x:Name="Backdrop" IsHitTestVisible="False" ClipToBounds="True" Visibility="{Binding IsGlass, Converter={StaticResource BoolToVis}}">
            <Image x:Name="BackA" Stretch="UniformToFill" Margin="-60" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <BlurEffect Radius="60" RenderingBias="Performance" KernelType="Gaussian" />
                </Image.Effect>
            </Image>
            <Image x:Name="BackB" Stretch="UniformToFill" Margin="-60" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <BlurEffect Radius="60" RenderingBias="Performance" KernelType="Gaussian" />
                </Image.Effect>
            </Image>
            <Rectangle Opacity="0.55">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="TintA" Color="#FF26262C" Offset="0" />
                        <GradientStop x:Name="TintC" Color="#FF1C1C21" Offset="0.5" />
                        <GradientStop x:Name="TintB" Color="#FF141418" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- keeps white text readable on bright artwork -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#40000000" Offset="0" />
                        <GradientStop Color="#73000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <Grid x:Name="Root">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="92" />
            </Grid.RowDefinitions>

            <!-- ============================================================ title bar -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource LogoBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource LogoForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Yesify" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="mini" ContentTemplate="{StaticResource MiniPlayerGlyph}" Command="{Binding OpenMiniPlayerCommand}" ToolTip="Open miniplayer" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close (keeps playing in the tray)" />
                </StackPanel>
            </Grid>

            <!-- ============================================================ body -->
            <Grid Grid.Row="1" Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="248" />
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="RightColumn" Width="0" MaxWidth="640" />
                </Grid.ColumnDefinitions>

                <!-- sidebar: Library and Search; slides between full width and an icon strip -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Margin="0,0,8,0" ClipToBounds="True">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Same padding and 18 px icon box as the entries below, so all icons line up. -->
                        <Button Grid.Row="0" Style="{StaticResource NavButton}" HorizontalAlignment="Left" Margin="0,0,0,8"
                                Command="{Binding ToggleSidebarCommand}" ToolTip="Show / hide sidebar">
                            <ContentControl Width="18" Height="16" Content="sidebar" ContentTemplate="{StaticResource SidebarGlyph}"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>

                        <StackPanel Grid.Row="1">
                            <Button Style="{StaticResource SideNavButton}" Command="{Binding ShowLibraryCommand}" Tag="{Binding IsLibraryView}" ToolTip="Library">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" Width="18" TextAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="Library" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               Opacity="{Binding SidebarWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarLabelOpacity}}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SideNavButton}" Command="{Binding ShowSearchCommand}" Tag="{Binding IsSearchView}" ToolTip="Search your library" Margin="0,2,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" Width="18" TextAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="Search" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               Opacity="{Binding SidebarWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarLabelOpacity}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Button Grid.Row="3" Style="{StaticResource NavButton}" Command="{Binding OpenSettingsCommand}" Margin="0,8,0,0" ToolTip="Settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" Width="18" TextAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="Settings" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Opacity="{Binding SidebarWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarLabelOpacity}}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- main: the header is the list's first row, so it scrolls with the songs -->
                <Border Grid.Column="1" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource MainPanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Library: a grid of covers -->
                    <ScrollViewer x:Name="LibraryScroller" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsLibraryView, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="32,28,20,24">
                            <TextBlock Text="Library" FontSize="40" FontWeight="Bold" />
                            <ItemsControl ItemsSource="{Binding LibraryItems}" Margin="-8,18,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:LibraryItem}">
                                        <Button Width="184" Margin="0,0,4,8" Cursor="Hand" Foreground="{StaticResource TextBrush}" Click="LibraryTile_Click" ContextMenuOpening="LibraryTile_ContextMenuOpening">
                                            <Button.ContextMenu>
                                                <ContextMenu />
                                            </Button.ContextMenu>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="8">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RaisedBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel>
                                                <Grid Width="168" Height="168">
                                                    <!-- artwork (or the first song's cover) -->
                                                    <Border x:Name="Art" CornerRadius="8" Background="{DynamicResource RaisedBrush}">
                                                        <Grid>
                                                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="40" Foreground="{DynamicResource FaintTextBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Border CornerRadius="8" local:AsyncImage.BackgroundUrl="{Binding Image}" local:AsyncImage.Width="336" />
                                                        </Grid>
                                                    </Border>
                                                    <!-- Liked Songs -->
                                                    <Border x:Name="Liked" CornerRadius="8" Visibility="Collapsed" Background="{DynamicResource LikedTileBrush}"
                                                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                                                        <TextBlock Text="&#xEB52;" FontFamily="{StaticResource IconFont}" FontSize="56" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <!-- New Playlist / Import Playlist -->
                                                    <Border x:Name="Action" CornerRadius="8" Visibility="Collapsed" BorderThickness="1.5" BorderBrush="#40FFFFFF" Background="#0DFFFFFF">
                                                        <TextBlock x:Name="ActionIcon" Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="36" Foreground="{DynamicResource SubtleTextBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="2,10,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Margin="2,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Liked">
                                                <Setter TargetName="Art" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="Liked" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="NewPlaylist">
                                                <Setter TargetName="Art" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="Action" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Import">
                                                <Setter TargetName="Art" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="Action" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="ActionIcon" Property="Text" Value="&#xE71B;" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Search bar: fixed above the results (inside the list it would be rebuilt as results change) -->
                    <StackPanel Margin="32,28,32,0" Visibility="{Binding IsSearchView, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Search" FontSize="40" FontWeight="Bold" />
                        <Grid Margin="0,14,0,0" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBox x:Name="LibrarySearchBox" Style="{StaticResource InputBox}" Width="560" Padding="40,0,14,0"
                                     Text="{Binding LibraryQuery, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="SearchBox_IsVisibleChanged" />
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource SubtleTextBrush}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="16,0,0,0" />
                            <TextBlock Text="Songs, artists or albums in your library" Foreground="{DynamicResource FaintTextBrush}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="42,0,0,0"
                                       Visibility="{Binding LibraryQuery, Converter={StaticResource InvNullToVis}}" />
                        </Grid>
                    </StackPanel>

                    <ListBox x:Name="TrackList" Grid.Row="1" Visibility="{Binding IsTrackView, Converter={StaticResource BoolToVis}}"
                             ContextMenuOpening="TrackList_ContextMenuOpening"
                             ItemContainerStyleSelector="{StaticResource TrackRows}"
                             Background="Transparent" BorderThickness="0" Padding="16,0,16,16"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ContextMenu>
                            <ContextMenu /> <!-- filled in TrackList_ContextMenuOpening -->
                        </ListBox.ContextMenu>
                        <ListBox.Resources>
                            <!-- header -->
                            <DataTemplate DataType="{x:Type m:HeaderMarker}">
                                <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Margin="8,28,8,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="176" Height="176" CornerRadius="8" Margin="0,0,24,0"
                                            Background="{DynamicResource LikedTileBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                                            Visibility="{Binding ViewIsLikedHeader, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xEB52;" FontFamily="{StaticResource IconFont}" FontSize="64" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Width="176" Height="176" CornerRadius="8" Margin="0,0,24,0" ClipToBounds="True"
                                            Visibility="{Binding ViewImageUrl, Converter={StaticResource NullToVis}}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.5" />
                                        </Border.Effect>
                                        <Image local:AsyncImage.Url="{Binding ViewImageUrl}" local:AsyncImage.Width="360" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding ViewTitle}" FontSize="40" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding ViewTitle, Converter={StaticResource NullToVis}}" />

                                        <TextBlock Text="{Binding ViewSubtitle}" Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ViewDescription}" Margin="0,8,0,0" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"
                                                   MaxWidth="560" HorizontalAlignment="Left" Visibility="{Binding ViewDescription, Converter={StaticResource NullToVis}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button Style="{StaticResource AccentPlayButton}" Content="&#xE768;" Command="{Binding PlayAllCommand}" ToolTip="Play" Margin="0,0,12,0"
                                                    Visibility="{Binding HasTracks, Converter={StaticResource BoolToVis}}" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE8B1;" FontSize="20" Width="44" Height="44" Command="{Binding ShuffleAllCommand}" ToolTip="Shuffle play"
                                                    Visibility="{Binding HasTracks, Converter={StaticResource BoolToVis}}" />
                                            <Button FontSize="18" Width="44" Height="44" Margin="4,0,0,0" Command="{Binding ToggleSaveCurrentCommand}"
                                                    Visibility="{Binding CurrentCollection, Converter={StaticResource NullToVis}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                        <Setter Property="Content" Value="&#xE710;" />
                                                        <Setter Property="ToolTip" Value="Add to Library" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrentSaved}" Value="True">
                                                                <Setter Property="Content" Value="&#xE73E;" />
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                <Setter Property="ToolTip" Value="In your Library. Click to remove" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE712;" FontSize="18" Width="44" Height="44" Margin="4,0,0,0"
                                                    ToolTip="More" Click="HeaderMore_Click" Visibility="{Binding HasHeaderMenu, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="Loading…" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}"
                                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>

                            <!-- song row -->
                            <DataTemplate DataType="{x:Type m:Track}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="5*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Num" Text="{Binding Number}" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,16,0">
                                        <Border Width="40" Height="40" CornerRadius="4" Background="{DynamicResource RaisedBrush}" ClipToBounds="True">
                                            <Image local:AsyncImage.Url="{Binding ImageUrl}" local:AsyncImage.Width="80" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Album}" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <Button Grid.Column="3" Style="{StaticResource HeartButton}" Command="{Binding DataContext.ToggleLikeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    <TextBlock Grid.Column="4" Text="{Binding DurationText}" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource SameObject}">
                                                <Binding />
                                                <Binding Path="DataContext.CurrentTrack" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="Num" Property="FontFamily" Value="{StaticResource IconFont}" />
                                        <Setter TargetName="Num" Property="Text" Value="&#xE995;" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>
                    </Grid>
                </Border>

                <!-- drag to resize the right panel -->
                <GridSplitter x:Name="RightSplitter" Grid.Column="2" Width="8" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                              Background="Transparent" Cursor="SizeWE" DragCompleted="RightSplitter_DragCompleted"
                              Visibility="{Binding IsRightPanelOpen, Converter={StaticResource BoolToVis}}" />

                <!-- right panel: lyrics / queue -->
                <Border Grid.Column="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10"
                        Visibility="{Binding IsRightPanelOpen, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="12,10,8,4">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PillButton}" Content="Lyrics" Command="{Binding ToggleLyricsCommand}" Padding="14,6" Margin="0,0,6,0"
                                        Background="{Binding ShowLyrics, Converter={StaticResource TabBackground}}" />
                                <Button Style="{StaticResource PillButton}" Content="Queue" Command="{Binding ToggleQueueCommand}" Padding="14,6"
                                        Background="{Binding ShowQueue, Converter={StaticResource TabBackground}}" />
                            </StackPanel>
                        </Grid>

                        <!-- lyrics -->
                        <Grid Grid.Row="1" Visibility="{Binding ShowLyrics, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding LyricsStatus}" Foreground="{DynamicResource SubtleTextBrush}" Margin="20,8" TextWrapping="Wrap" />
                            <ScrollViewer x:Name="LyricsScroller" VerticalScrollBarVisibility="Hidden">
                                <!-- note: scrolled by LyricsAnimator with an eased animation -->
                                <!-- Each line is its words (lit by a gradient sweep, see LyricsAnimator) or, for an
                                     instrumental break, three dots that fill up. -->
                                <ItemsControl x:Name="LyricsList" ItemsSource="{Binding Lyrics}" Margin="22,8,22,240"
                                              TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Animated" TextOptions.TextRenderingMode="Grayscale">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type m:LyricLine}">
                                            <Grid x:Name="LineRoot" Margin="0,9" Cursor="Hand" MouseLeftButtonUp="Lyric_Click" RenderTransformOrigin="0,0.5">
                                                <Grid.RenderTransform>
                                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                                </Grid.RenderTransform>
                                                <ItemsControl ItemsSource="{Binding Words}" Focusable="False"
                                                              Visibility="{Binding IsBreak, Converter={StaticResource InvBoolToVis}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type m:LyricWord}">
                                                            <TextBlock Text="{Binding Text}" FontSize="24" FontWeight="Bold" Loaded="LyricWord_Loaded" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Orientation="Horizontal" Height="40" RenderTransformOrigin="0,0.5"
                                                            Visibility="{Binding IsBreak, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel.RenderTransform>
                                                        <ScaleTransform />
                                                    </StackPanel.RenderTransform>
                                                    <Ellipse Width="11" Height="11" Fill="White" Opacity="0.3" Margin="2,0,7,0" VerticalAlignment="Center" />
                                                    <Ellipse Width="11" Height="11" Fill="White" Opacity="0.3" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                    <Ellipse Width="11" Height="11" Fill="White" Opacity="0.3" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- queue -->
                        <ScrollViewer x:Name="QueueScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowQueue, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="10,0,10,16">
                                <TextBlock Text="NOW PLAYING" Style="{StaticResource SectionLabel}" Margin="6,10,0,8" />
                                <Grid Margin="6,0" Visibility="{Binding CurrentTrack, Converter={StaticResource NullToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="4" Background="{DynamicResource RaisedBrush}" ClipToBounds="True">
                                        <Image local:AsyncImage.Url="{Binding CurrentTrack.ImageUrl}" local:AsyncImage.Width="80" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentTrack.Title}" FontSize="13" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CurrentTrack.Artist}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="UP NEXT" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="Nothing queued. Right-click a song → Play next or Add to queue." FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource FaintTextBrush}" Margin="6,0"
                                           Visibility="{Binding UpNextView.Count, Converter={StaticResource ZeroToVis}}" />
                                <ItemsControl x:Name="UpNextList" ItemsSource="{Binding UpNextView}" ItemTemplate="{StaticResource QueueRow}"
                                              PreviewMouseLeftButtonDown="UpNext_MouseDown" PreviewMouseMove="UpNext_MouseMove"
                                              PreviewMouseLeftButtonUp="UpNext_MouseUp" LostMouseCapture="UpNext_LostCapture" />

                                <TextBlock Text="RECENTLY PLAYED" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="Songs you play show up here." FontSize="12" Foreground="{DynamicResource FaintTextBrush}" Margin="6,0"
                                           Visibility="{Binding HistoryView.Count, Converter={StaticResource ZeroToVis}}" />
                                <ItemsControl x:Name="HistoryList" ItemsSource="{Binding HistoryView}" ItemTemplate="{StaticResource QueueRow}"
                                              MouseLeftButtonUp="HistoryList_MouseUp" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================================ player bar -->
            <Grid Grid.Row="2" Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="220" />
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="3*" MinWidth="240" />
                </Grid.ColumnDefinitions>

                <!-- now playing -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding CurrentTrack, Converter={StaticResource NullToVis}}">
                    <Border Width="56" Height="56" CornerRadius="6" Background="{DynamicResource RaisedBrush}" ClipToBounds="True">
                        <Image local:AsyncImage.Url="{Binding CurrentTrack.ImageUrl}" local:AsyncImage.Width="112" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" MaxWidth="260">
                        <TextBlock Text="{Binding CurrentTrack.Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CurrentTrack.Artist}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource HeartButton}" DataContext="{Binding CurrentTrack}" Margin="10,0,0,0" VerticalAlignment="Center"
                            Command="{Binding DataContext.ToggleLikeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </StackPanel>

                <!-- transport -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="640">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE8B1;" Command="{Binding ToggleShuffleCommand}" ToolTip="Shuffle"
                                Foreground="{Binding Shuffle, Converter={StaticResource ActiveBrush}}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" Command="{Binding PreviousCommand}" Margin="8,0,0,0" ToolTip="Previous" />
                        <Grid Margin="12,0">
                            <Button Style="{StaticResource PlayButton}" Content="{Binding IsPlaying, Converter={StaticResource PlayGlyph}}" Command="{Binding TogglePlayCommand}" ToolTip="Play / Pause" />
                            <!-- Loading ring. The animation only exists while a song is loading: WPF keeps ticking
                                 "Forever" animations even on hidden elements, which costs CPU for nothing. -->
                            <Ellipse Width="46" Height="46" StrokeThickness="2" Stroke="{DynamicResource AccentBrush}" StrokeDashArray="3 2" IsHitTestVisible="False"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform />
                                </Ellipse.RenderTransform>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsResolving}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="SpinStoryboard">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.2" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <RemoveStoryboard BeginStoryboardName="SpinStoryboard" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" Command="{Binding NextCommand}" Margin="0,0,8,0" ToolTip="Next (unlimited)" />
                        <Button Style="{StaticResource IconButton}" Content="{Binding Repeat, Converter={StaticResource RepeatGlyph}}" Command="{Binding CycleRepeatCommand}" ToolTip="Repeat"
                                Foreground="{Binding Repeat, Converter={StaticResource ActiveBrush}}" />
                    </StackPanel>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PositionText}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                        <Slider x:Name="SeekBar" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0"
                                Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}"
                                PreviewMouseLeftButtonDown="SeekBar_MouseDown" PreviewMouseLeftButtonUp="SeekBar_MouseUp" />
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>

                <!-- right side -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BD;" Command="{Binding ToggleLyricsCommand}" ToolTip="Lyrics"
                            Foreground="{Binding ShowLyrics, Converter={StaticResource ActiveBrush}}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8FD;" Command="{Binding ToggleQueueCommand}" ToolTip="Queue" Margin="4,0,0,0"
                            Foreground="{Binding ShowQueue, Converter={StaticResource ActiveBrush}}" />
                    <Button Style="{StaticResource IconButton}" Content="mini" ContentTemplate="{StaticResource MiniPlayerGlyph}" Command="{Binding OpenMiniPlayerCommand}" ToolTip="Open miniplayer" Margin="4,0,0,0" />
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="12,0,8,0" />
                    <Slider Style="{StaticResource ThinSlider}" Width="110" Minimum="0" Maximum="1" Value="{Binding Volume}" VerticalAlignment="Center"
                            local:SliderDrag.WheelStep="0.05" ToolTip="{Binding Volume, Converter={StaticResource Percent}}" />
                </StackPanel>
            </Grid>

            <!-- status toast -->
            <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Padding="16,10" CornerRadius="8"
                    Background="{DynamicResource ToastBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" MaxWidth="640" Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}"
                    MouseLeftButtonUp="Status_Click" Cursor="Hand">
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="13" />
            </Border>
        </Grid>

        <!-- ============================================================ playlist editor (Apple Music-style) -->
        <Grid Background="#80000000" Visibility="{Binding IsEditingPlaylist, Converter={StaticResource BoolToVis}}"
              MouseLeftButtonDown="EditorBackdrop_MouseDown">
            <Grid Width="600" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border local:Frost.Enabled="True" CornerRadius="14" />
            <Border CornerRadius="14" Padding="26"
                    Background="{DynamicResource SettingsCardBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                    MouseLeftButtonDown="SettingsCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- cover: click to pick an image -->
                    <Grid x:Name="EditorCover" Width="200" Height="200" Cursor="Hand" MouseLeftButtonUp="EditorCover_Click" ToolTip="Choose an image">
                        <Border CornerRadius="10" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="52" Foreground="{DynamicResource FaintTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="10" local:AsyncImage.BackgroundUrl="{Binding EditCoverPreview}" local:AsyncImage.Width="400" />
                        <Border CornerRadius="10" Background="#99000000">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=EditorCover}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="22" HorizontalAlignment="Center" />
                                <TextBlock Text="Choose Image" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="22,0,0,0">
                        <Grid>
                            <TextBox x:Name="EditorTitle" Style="{StaticResource FieldBox}" FontSize="22" FontWeight="Bold" Padding="10,8"
                                     Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenShown">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SavePlaylistCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="Playlist Title" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource FaintTextBrush}" Margin="13,9,0,0"
                                       IsHitTestVisible="False" Visibility="{Binding EditTitle, Converter={StaticResource InvNullToVis}}" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding EditAuthor, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Author (optional)" Foreground="{DynamicResource FaintTextBrush}" Margin="13,9,0,0" FontSize="14"
                                       IsHitTestVisible="False" Visibility="{Binding EditAuthor, Converter={StaticResource InvNullToVis}}" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <TextBox Style="{StaticResource FieldBox}" Height="86" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Description (optional)" Foreground="{DynamicResource FaintTextBrush}" Margin="13,9,0,0" FontSize="14"
                                       IsHitTestVisible="False" Visibility="{Binding EditDescription, Converter={StaticResource InvNullToVis}}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Style="{StaticResource PillButton}" Content="Cancel" Command="{Binding CancelEditPlaylistCommand}" Margin="0,0,10,0" />
                        <Button Command="{Binding SavePlaylistCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentPillButton}">
                                    <Setter Property="Content" Value="Save" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EditIsNew}" Value="True">
                                            <Setter Property="Content" Value="Create" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>
        </Grid>

        <!-- ============================================================ import playlist -->
        <Grid Background="#80000000" Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}"
              MouseLeftButtonDown="ImportBackdrop_MouseDown">
            <Grid Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border local:Frost.Enabled="True" CornerRadius="14" />
            <Border CornerRadius="14" Padding="26,22,26,24"
                    Background="{DynamicResource SettingsCardBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                    MouseLeftButtonDown="SettingsCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Import Playlist" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Paste a link to a Spotify playlist or album, or a YouTube playlist. It's added to your library."
                               TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,8,0,16" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenShown">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ConfirmImportCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding CancelImportCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource PillButton}" Content="Cancel" Command="{Binding CancelImportCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource AccentPillButton}" Content="Import" Command="{Binding ConfirmImportCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            </Grid>
        </Grid>

        <!-- ============================================================ settings -->
        <Grid Background="#80000000" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}"
              MouseLeftButtonDown="SettingsBackdrop_MouseDown">
            <Grid Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border local:Frost.Enabled="True" CornerRadius="14" />
            <Border CornerRadius="14" Padding="26,22,26,26"
                    Background="{DynamicResource SettingsCardBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                    MouseLeftButtonDown="SettingsCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="12" HorizontalAlignment="Right" Command="{Binding CloseSettingsCommand}" ToolTip="Close (Esc)" />
                    </Grid>

                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" Margin="0,22,0,10" />
                    <CheckBox Style="{StaticResource SwitchBox}" IsChecked="{Binding IsLightweight}">
                        <TextBlock Text="Lightweight mode" FontSize="14" Foreground="{StaticResource TextBrush}" />
                    </CheckBox>
                    <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,6,60,0"
                               Text="Flat dark look drawn by the CPU, with simple lyrics and no artwork backgrounds. Uses the least memory and power. Turn it off for the glass look." />

                    <TextBlock Text="DISCORD" Style="{StaticResource SectionLabel}" Margin="0,24,0,10" />
                    <CheckBox Style="{StaticResource SwitchBox}" IsChecked="{Binding ShowOnDiscord}">
                        <TextBlock Text="Show what I'm listening to" FontSize="14" Foreground="{StaticResource TextBrush}" />
                    </CheckBox>
                    <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,6,60,0"
                               Text="Your Discord status shows the song, the artist, the album cover and how far into the song you are. It clears while paused." />

                    <TextBlock Text="STORAGE" Style="{StaticResource SectionLabel}" Margin="0,24,0,10" />
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Downloaded audio" FontSize="14" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,3,0,0">
                                <Run Text="{Binding CacheSizeText, Mode=OneWay}" /><Run Text=" · songs are re-downloaded when played again" />
                            </TextBlock>
                        </StackPanel>
                        <Button Style="{StaticResource PillButton}" Content="Clear" HorizontalAlignment="Right" Command="{Binding ClearAudioCacheCommand}" />
                    </Grid>

                    <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}" Margin="0,24,0,10" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{DynamicResource SubtleTextBrush}"
                               Text="Yesify · playlists from Spotify's public pages, audio from YouTube, lyrics from LRCLIB. No account, no ads, unlimited skips." />
                </StackPanel>
            </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

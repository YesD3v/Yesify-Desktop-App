<Window x:Class="Yesify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Yesify"
        xmlns:m="clr-namespace:Yesify.Models"
        Title="Yesify" Width="1280" Height="800" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontWeight="SemiBold"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Song row container (hover / selected highlight, double-click to play). -->
        <Style x:Key="TrackRowStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <EventSetter Event="MouseDoubleClick" Handler="TrackRow_DoubleClick" />
            <EventSetter Event="MouseEnter" Handler="TrackRow_MouseEnter" />
            <EventSetter Event="MouseLeave" Handler="TrackRow_MouseLeave" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="8,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header row: no highlight, never selected. -->
        <Style x:Key="PlainRowStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clickable artist / album names in song rows and the player bar -->
        <Style x:Key="LinkText" TargetType="TextBlock">
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A row of tiles (Home, artist pages, Explore, search): albums, artists, playlists, genres, songs.
             "Show all" opens the row's own page; Wrap rows show every tile. -->
        <DataTemplate x:Key="SectionTemplate">
            <StackPanel Margin="0,26,0,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI" Visibility="{Binding Title, Converter={StaticResource NullToVis}}" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,2,0,0"
                                   Visibility="{Binding Subtitle, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                    <Button Style="{StaticResource PillButton}" Content="Show all" Padding="12,5" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                            Background="Transparent" Foreground="{DynamicResource SubtleTextBrush}"
                            Command="{Binding DataContext.OpenSectionMoreCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            Visibility="{Binding MoreId, Converter={StaticResource NullToVis}}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Items}" Margin="-8,10,0,0">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate>
                                        <local:OneRowPanel />
                                    </ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Wrap}" Value="True">
                                    <Setter Property="ItemsPanel">
                                        <Setter.Value>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="Tile" Width="184" Margin="0,0,4,4" Cursor="Hand" Foreground="{StaticResource TextBrush}" Click="HomeTile_Click" ToolTip="{Binding Title}"
                                    ContextMenuOpening="HomeTile_ContextMenuOpening">
                                <Button.ContextMenu>
                                    <ContextMenu /> <!-- filled in HomeTile_ContextMenuOpening -->
                                </Button.ContextMenu>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="14" Padding="8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RaisedBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <StackPanel x:Name="Cover">
                                        <Border x:Name="Art" Width="168" Height="168" CornerRadius="12" Background="{DynamicResource RaisedBrush}">
                                            <Grid>
                                                <TextBlock x:Name="Placeholder" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="40" Foreground="{DynamicResource FaintTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Border x:Name="Pic" CornerRadius="12" local:AsyncImage.BackgroundUrl="{Binding ImageUrl}" local:AsyncImage.Width="336" />
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="Name" Text="{Binding Title}" FontSize="14" FontWeight="Bold" Margin="2,10,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="Sub" Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Margin="2,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <!-- genre / mood: a colored stripe and its name -->
                                    <Border x:Name="Genre" Visibility="Collapsed" Width="168" Height="64" CornerRadius="8" Background="{DynamicResource RaisedBrush}" ClipToBounds="True">
                                        <Grid>
                                            <Border Width="6" HorizontalAlignment="Left" CornerRadius="8,0,0,8" Background="{Binding Color}" />
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,10,0" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Artist">
                                    <Setter TargetName="Art" Property="CornerRadius" Value="84" />
                                    <Setter TargetName="Pic" Property="CornerRadius" Value="84" />
                                    <Setter TargetName="Placeholder" Property="Text" Value="&#xE77B;" />
                                    <Setter TargetName="Name" Property="TextAlignment" Value="Center" />
                                    <Setter TargetName="Sub" Property="TextAlignment" Value="Center" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="MusicArtist">
                                    <Setter TargetName="Art" Property="CornerRadius" Value="84" />
                                    <Setter TargetName="Pic" Property="CornerRadius" Value="84" />
                                    <Setter TargetName="Placeholder" Property="Text" Value="&#xE77B;" />
                                    <Setter TargetName="Name" Property="TextAlignment" Value="Center" />
                                    <Setter TargetName="Sub" Property="TextAlignment" Value="Center" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="MusicCategory">
                                    <Setter TargetName="Cover" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Genre" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Tile" Property="ToolTip" Value="{x:Null}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <local:SkeletonWidthConverter x:Key="SkeletonWidth" />
        <local:RowStyleSelector x:Key="TrackRows" Default="{StaticResource TrackRowStyle}" Plain="{StaticResource PlainRowStyle}" />

        <!-- Queue panel row -->
        <DataTemplate x:Key="QueueRow" DataType="{x:Type m:QueueItem}">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6" Cursor="Hand" RenderTransformOrigin="0.5,0.5"
                    ContextMenuOpening="QueueRow_ContextMenuOpening">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform />
                        <TranslateTransform />
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.ContextMenu>
                    <ContextMenu /> <!-- filled in QueueRow_ContextMenuOpening -->
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="4" Background="{DynamicResource RaisedBrush}" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource FaintTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image local:AsyncImage.Url="{Binding Track.ImageUrl}" local:AsyncImage.Width="80" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Track.Title}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Track.Artist}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RaisedBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
            <Setter Property="Margin" Value="6,18,0,8" />
        </Style>

        <!-- Library grid tile: cover (Liked Songs gets its drawn cover), name, subtitle. -->
        <DataTemplate x:Key="LibraryTile" DataType="{x:Type m:LibraryItem}">
            <Button Width="184" Margin="0,0,4,8" Cursor="Hand" Foreground="{StaticResource TextBrush}" Click="LibraryTile_Click" ContextMenuOpening="LibraryTile_ContextMenuOpening">
                <Button.ContextMenu>
                    <ContextMenu />
                </Button.ContextMenu>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="14" Padding="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RaisedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <Grid Width="168" Height="168">
                        <Border x:Name="Art" CornerRadius="12" Background="{DynamicResource RaisedBrush}">
                            <Grid>
                                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="40" Foreground="{DynamicResource FaintTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border CornerRadius="12" local:AsyncImage.BackgroundUrl="{Binding Image}" local:AsyncImage.Width="336" />
                            </Grid>
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Width="28" Height="28" CornerRadius="9" Background="#8C000000"
                                Panel.ZIndex="1" ToolTip="Pinned" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}">
                            <local:Icon Glyph="&#xE718;" FontSize="12" Foreground="White" />
                        </Border>
                        <Border x:Name="Liked" CornerRadius="12" Visibility="Collapsed" Background="{DynamicResource LikedTileBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                            <local:Icon Glyph="&#xEB52;" FontSize="58" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <local:Icon.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35" />
                                </local:Icon.Effect>
                            </local:Icon>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Margin="2,10,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Margin="2,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Liked">
                    <Setter TargetName="Art" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Liked" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Library list row: small cover, name and subtitle. -->
        <DataTemplate x:Key="LibraryRow" DataType="{x:Type m:LibraryItem}">
            <Button Margin="0,0,0,2" Cursor="Hand" Foreground="{StaticResource TextBrush}" HorizontalContentAlignment="Stretch"
                    Click="LibraryTile_Click" ContextMenuOpening="LibraryTile_ContextMenuOpening">
                <Button.ContextMenu>
                    <ContextMenu />
                </Button.ContextMenu>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="8,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RaisedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Art" Width="52" Height="52" CornerRadius="9" Background="{DynamicResource RaisedBrush}">
                        <Grid>
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource FaintTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border CornerRadius="9" local:AsyncImage.BackgroundUrl="{Binding Image}" local:AsyncImage.Width="104" />
                        </Grid>
                    </Border>
                    <Border x:Name="Liked" Width="52" Height="52" CornerRadius="9" Visibility="Collapsed" Background="{DynamicResource LikedTileBrush}">
                        <local:Icon Glyph="&#xEB52;" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <local:Icon Grid.Column="1" Glyph="&#xE718;" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,8,0" ToolTip="Pinned" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Liked">
                    <Setter TargetName="Art" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Liked" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Loading ring for a play button (see the player bar): a light that sweeps round, with a soft pulse. -->
        <Style x:Key="LoadingRing" TargetType="Ellipse">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="StrokeThickness" Value="2.5" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Stroke">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                        <GradientStop Color="#99FFFFFF" Offset="0.3" />
                        <GradientStop Color="#00FFFFFF" Offset="0.62" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsResolving}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="RingSpin">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)"
                                                 From="0.94" To="1.04" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)"
                                                 From="0.94" To="1.04" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="RingSpin" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ============================================================ glass backdrop
             Artwork decoded tiny and stretched (reads as a blur), tinted with its own vivid colors. -->
        <Grid x:Name="Backdrop" IsHitTestVisible="False" ClipToBounds="True" >
            <!-- The blurred artwork is kept as a half-size bitmap: without the cache, the two full-window blurs
                 are recomputed on every frame that anything above them changes (lyrics, the seek bar). -->
            <Grid x:Name="BackImages" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform />
                        <RotateTransform />
                        <TranslateTransform />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Grid.CacheMode>
                    <BitmapCache RenderAtScale="0.5" EnableClearType="False" />
                </Grid.CacheMode>
                <Image x:Name="BackA" Stretch="UniformToFill" Margin="-60" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <BlurEffect Radius="60" RenderingBias="Performance" KernelType="Gaussian" />
                    </Image.Effect>
                </Image>
                <Image x:Name="BackB" Stretch="UniformToFill" Margin="-60" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <BlurEffect Radius="60" RenderingBias="Performance" KernelType="Gaussian" />
                    </Image.Effect>
                </Image>
            </Grid>
            <Rectangle x:Name="TintLayer" Opacity="0.5">
                <Rectangle.Fill>
                    <LinearGradientBrush x:Name="TintBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="TintA" Color="#FF26262C" Offset="0" />
                        <GradientStop x:Name="TintC" Color="#FF1C1C21" Offset="0.5" />
                        <GradientStop x:Name="TintB" Color="#FF141418" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- keeps white text readable on bright artwork (Settings → Background → Brightness) -->
            <Rectangle x:Name="DimLayer">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#14000000" Offset="0" />
                        <GradientStop Color="#2E000000" Offset="0.5" />
                        <GradientStop Color="#6B000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="DarkLayer" Fill="Black" Opacity="0" />
        </Grid>

        <Grid x:Name="Root">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="96" />
            </Grid.RowDefinitions>

            <!-- ============================================================ title bar -->
            <Grid Grid.Row="0">
                <!-- The Yesify mark, centered over the sidebar's icons (they sit 40 px in). A vector traced from the
                     logo, so it's sharp at any size and screen scale. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0,0,0">
                    <Path Width="20" Height="16.84" Stretch="Uniform" Fill="White" VerticalAlignment="Center" ToolTip="Yesify"
                          Data="F1 M2.35,4.31 L1.52,5.51 0.71,7.24 0.21,8.96 0,10.54 0,26.43 0.17,28.57 0.65,30.97 1.22,32.88 2.03,34.91 2.83,36.45 3.94,38.21 5.31,39.93 6.37,41.06 8.17,42.62 9.94,43.84 11.92,44.99 13.72,45.75 15.15,46.23 16.65,46.62 19.54,47.02 60.03,47.06 61.38,47.32 61.94,47.55 62.54,47.93 63.03,48.37 63.75,49.46 63.99,50.17 64.12,50.99 64.12,55.98 63.99,56.88 63.72,57.74 63.14,58.79 62.35,59.63 61.34,60.3 59.92,60.76 59.13,60.85 16.01,60.85 14.59,61.03 13.31,61.31 12.04,61.78 10.8,62.38 9.34,63.37 8.51,64.08 7.74,64.9 6.9,65.99 6.31,67 5.65,68.47 5.33,69.52 5.1,70.79 4.99,71.8 4.99,74.73 5.16,76.19 5.47,77.47 5.93,78.7 6.82,80.24 7.65,81.25 8.59,82.13 10.16,83.16 11.62,83.76 13.24,84.11 15.34,84.21 86.43,84.18 88.08,84 89.43,83.69 90.96,83.14 92.13,82.59 92.99,82.09 94.41,81.08 95.54,80.05 96.64,78.82 97.77,77.2 98.38,76.08 99.11,74.39 99.54,72.93 99.79,71.69 100,69.44 100,11.06 99.86,9.56 99.58,8.17 99.19,7.01 98.68,5.92 97.46,4.09 96.7,3.26 95.58,2.31 94.34,1.48 92.88,0.78 91.23,0.28 89.46,0.04 69.67,0.04 68.58,0.17 67.6,0.41 66.48,0.83 65.69,1.26 64.45,2.17 63.25,3.49 62.34,5.14 61.81,7.01 61.68,8.36 61.68,22.12 61.44,23.58 61.14,24.52 60.57,25.68 59.83,26.73 59.32,27.3 58.34,28.11 57.26,28.75 56.36,29.15 55.23,29.45 54.22,29.58 45.82,29.58 44.21,29.35 42.86,28.86 41.58,28.11 40.61,27.3 39.75,26.28 39.19,25.38 38.76,24.45 38.42,23.21 38.28,22.2 38.28,8.21 38.01,6.3 37.56,4.95 37.07,4.01 36.46,3.15 35.17,1.85 33.67,0.91 31.95,0.27 29.88,0 11.55,0 10.01,0.07 7.95,0.49 6.67,0.96 5.85,1.36 4.16,2.46 3.07,3.45 Z" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE72B;" FontSize="12" Width="28" Height="28" Margin="10,0,0,0" ToolTip="Back (mouse back button)"
                            Command="{Binding GoBackCommand}" WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Padding="3" CornerRadius="11"
                        Background="{DynamicResource GlassChipBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Content="mini" ContentTemplate="{StaticResource MiniPlayerGlyph}" Command="{Binding OpenMiniPlayerCommand}" ToolTip="Open miniplayer" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close (keeps playing in the tray)" />
                </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================================ body -->
            <Grid Grid.Row="1" Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="248" />
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="RightColumn" Width="0" MaxWidth="640" />
                </Grid.ColumnDefinitions>

                <!-- sidebar: Library and Search; slides between full width and an icon strip -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                        CornerRadius="16" Margin="0,0,8,0" ClipToBounds="True">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Same padding and 18 px icon box as the entries below, so all icons line up. -->
                        <Button Grid.Row="0" Style="{StaticResource NavButton}" HorizontalAlignment="Left" Margin="0,0,0,8"
                                Command="{Binding ToggleSidebarCommand}" ToolTip="Show / hide sidebar">
                            <ContentControl Width="18" Height="16" Content="sidebar" ContentTemplate="{StaticResource SidebarGlyph}"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>

                        <StackPanel Grid.Row="1">
                            <Button Style="{StaticResource SideNavButton}" Command="{Binding ShowHomeCommand}" Tag="{Binding IsHomeView}" ToolTip="Home">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Glyph="&#xE80F;" FontSize="16" VerticalAlignment="Center" Width="18" Margin="0,0,10,0" />
                                    <TextBlock Text="Home" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               Opacity="{Binding SidebarWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarLabelOpacity}}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SideNavButton}" Command="{Binding ShowLibraryCommand}" Tag="{Binding IsLibraryView}" ToolTip="Library" Margin="0,2,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Glyph="&#xE8F1;" FontSize="16" VerticalAlignment="Center" Width="18" Margin="0,0,10,0" />
                                    <TextBlock Text="Library" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               Opacity="{Binding SidebarWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarLabelOpacity}}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SideNavButton}" Command="{Binding ShowExploreCommand}" Tag="{Binding IsExploreView}" ToolTip="Explore: new releases, charts, moods and genres" Margin="0,2,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Glyph="&#xE774;" FontSize="16" VerticalAlignment="Center" Width="18" Margin="0,0,10,0" />
                                    <TextBlock Text="Explore" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               Opacity="{Binding SidebarWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarLabelOpacity}}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SideNavButton}" Command="{Binding ShowSearchCommand}" Tag="{Binding IsSearchView}" ToolTip="Search" Margin="0,2,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Glyph="&#xE721;" FontSize="16" VerticalAlignment="Center" Width="18" Margin="0,0,10,0" />
                                    <TextBlock Text="Search" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               Opacity="{Binding SidebarWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarLabelOpacity}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Button Grid.Row="3" Style="{StaticResource SideNavButton}" Command="{Binding OpenSettingsCommand}" Tag="{Binding IsSettingsView}" Margin="0,8,0,0" ToolTip="Settings">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Glyph="&#xE713;" FontSize="16" VerticalAlignment="Center" Width="18" Margin="0,0,10,0" />
                                <TextBlock Text="Settings" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Opacity="{Binding SidebarWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarLabelOpacity}}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- main: the header is the list's first row, so it scrolls with the songs -->
                <Border x:Name="MainPanel" Grid.Column="1" CornerRadius="16" ClipToBounds="True" Background="{DynamicResource MainPanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                    <Grid x:Name="MainContent">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Home: rows of mixes, songs, releases and artists picked from what you play -->
                    <ScrollViewer x:Name="HomeScroller" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" local:SmoothScroll.IsEnabled="True" Visibility="{Binding IsHomeView, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="32,28,20,24">
                            <Grid>
                                <TextBlock Text="{Binding Greeting}" FontSize="40" FontWeight="Black" FontFamily="Segoe UI Black, Segoe UI" />
                                <!-- New picks: the arrows turn while Home is being rebuilt, then ease to a stop -->
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Height="38" Padding="14,0,16,0" FontSize="13"
                                        Background="{DynamicResource GlassChipBrush}" Command="{Binding RefreshHomeCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PillButton}">
                                            <Setter Property="ToolTip" Value="Get new picks" />
                                            <Setter Property="Tag" Value="New picks" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHomeBuilding}" Value="True">
                                                    <Setter Property="ToolTip" Value="Finding new picks for you…" />
                                                    <Setter Property="Tag" Value="Finding…" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center" local:Spin.IsSpinning="{Binding IsHomeBuilding}">
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 13.6,9.6 A 5.7,5.7 0 1 1 11.8,3.7" />
                                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeLineJoin="Round"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Data="M 15.2,5.6 L 14,1.2 L 9.9,4.5 Z" />
                                        </Grid>
                                        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding HomeStatus}" FontSize="14" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" MaxWidth="560"
                                       HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="{Binding HomeStatus, Converter={StaticResource NullToVis}}" />
                            <!-- Placeholder rows that shimmer while the first Home is on its way -->
                            <ItemsControl ItemsSource="{x:Static local:Placeholders.Sections}" IsHitTestVisible="False"
                                          Visibility="{Binding ShowHomeSkeleton, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,26,0,0">
                                            <local:GlassBlock Width="220" Height="22" HorizontalAlignment="Left" CornerRadius="6" />
                                            <ItemsControl ItemsSource="{x:Static local:Placeholders.Tiles}" Margin="-8,10,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <local:OneRowPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Width="184" Margin="0,0,4,0">
                                                            <local:GlassBlock Width="168" Height="168" Margin="8,8,8,0" CornerRadius="8" />
                                                            <local:GlassBlock Width="128" Height="12" Margin="10,13,0,0" HorizontalAlignment="Left" CornerRadius="6" />
                                                            <local:GlassBlock Width="84" Height="10" Margin="10,8,0,8" HorizontalAlignment="Left" CornerRadius="5" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl x:Name="HomeSectionsList" ItemsSource="{Binding HomeSections}" ItemTemplate="{StaticResource SectionTemplate}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Library (Liner-style): title and toolbar (filter chips, search, grid/list, Create playlist /
                         Import), then the covers in rows, then matching songs. Virtualized: only the rows on screen
                         exist, so hundreds of album tiles scroll smoothly and don't keep their pictures in memory.
                         The rows are cut to the page width by MainWindow (RebuildLibraryRows). -->
                    <ItemsControl x:Name="LibraryList" Grid.RowSpan="2" Focusable="False" local:SmoothScroll.IsEnabled="True"
                                  Visibility="{Binding IsLibraryView, Converter={StaticResource BoolToVis}}"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1" VirtualizingPanel.CacheLengthUnit="Page"
                                  ScrollViewer.CanContentScroll="True">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type m:LibraryHeaderMarker}">
                                <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Margin="32,28,20,16">
                                    <TextBlock Text="Library" FontSize="40" FontWeight="Black" FontFamily="Segoe UI Black, Segoe UI" />
                                    <Grid Margin="0,18,12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="12" />
                                            <ColumnDefinition Width="*" MaxWidth="260" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource ChipButton}" Content="All" Command="{Binding SetLibraryFilterCommand}" CommandParameter="All"
                                                    Tag="{Binding LibraryFilter, Converter={StaticResource Equals}, ConverterParameter=All}" />
                                            <Button Style="{StaticResource ChipButton}" Content="Playlists" Margin="6,0,0,0" Command="{Binding SetLibraryFilterCommand}" CommandParameter="Playlists"
                                                    Tag="{Binding LibraryFilter, Converter={StaticResource Equals}, ConverterParameter=Playlists}" />
                                            <Button Style="{StaticResource ChipButton}" Content="Albums" Margin="6,0,0,0" Command="{Binding SetLibraryFilterCommand}" CommandParameter="Albums"
                                                    Tag="{Binding LibraryFilter, Converter={StaticResource Equals}, ConverterParameter=Albums}" />
                                        </StackPanel>
                                        <Grid Grid.Column="2">
                                            <TextBox x:Name="LibraryFilterBox" Style="{StaticResource InputBox}" Height="34" FontSize="13" Padding="34,0,12,0" Background="{DynamicResource GlassChipBrush}"
                                                     Text="{Binding LibraryFilterQuery, UpdateSourceTrigger=PropertyChanged}" />
                                            <local:Icon Glyph="&#xE721;" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Margin="11,0,0,0" IsHitTestVisible="False" />
                                            <TextBlock Text="Search library" FontSize="13" Foreground="{DynamicResource FaintTextBrush}" Margin="35,0,0,0" VerticalAlignment="Center"
                                                       IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Text, ElementName=LibraryFilterBox}" Value="" />
                                                                    <Condition Binding="{Binding IsKeyboardFocused, ElementName=LibraryFilterBox}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Border Grid.Column="3" Margin="8,0,0,0" Padding="2" CornerRadius="11" Background="{DynamicResource GlassChipBrush}"
                                                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource BarButton}" Content="&#xF0E2;" Width="34" Height="28" FontSize="13" ToolTip="Grid"
                                                        Command="{Binding SetLibraryListModeCommand}" CommandParameter="grid"
                                                        Tag="{Binding LibraryListMode, Converter={StaticResource Equals}, ConverterParameter=False}" />
                                                <Button Style="{StaticResource BarButton}" Content="&#xEA37;" Width="34" Height="28" FontSize="13" ToolTip="List"
                                                        Command="{Binding SetLibraryListModeCommand}" CommandParameter="list"
                                                        Tag="{Binding LibraryListMode, Converter={StaticResource Equals}, ConverterParameter=True}" />
                                            </StackPanel>
                                        </Border>
                                        <Button Grid.Column="4" Style="{StaticResource AccentPillButton}" Margin="8,0,0,0" Height="34" Padding="14,0,16,0" FontSize="13"
                                                Command="{Binding NewPlaylistCommand}" ToolTip="Create a new playlist">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Glyph="&#xE710;" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="Create playlist" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="5" Style="{StaticResource PillButton}" Margin="8,0,0,0" Height="34" Padding="14,0,16,0" FontSize="13"
                                                Background="{DynamicResource GlassChipBrush}" Command="{Binding BeginImportCommand}" ToolTip="Import a Spotify or YouTube playlist">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Glyph="&#xE71B;" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="Import" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{Binding LibraryEmptyText}" FontSize="14" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,28,0,0"
                                               Visibility="{Binding LibraryEmptyText, Converter={StaticResource NullToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type m:LibraryRowGroup}">
                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Margin" Value="24,0,20,0" />
                                            <Setter Property="ItemTemplate" Value="{StaticResource LibraryTile}" />
                                            <Setter Property="ItemsPanel">
                                                <Setter.Value>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsList}" Value="True">
                                                    <Setter Property="Margin" Value="24,0,32,0" />
                                                    <Setter Property="ItemTemplate" Value="{StaticResource LibraryRow}" />
                                                    <Setter Property="ItemsPanel">
                                                        <Setter.Value>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel />
                                                            </ItemsPanelTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                </ItemsControl>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type m:LibrarySongsMarker}">
                                <!-- Library search: matching songs from your library (liked, playlists, saved) -->
                                <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Margin="32,22,32,24" Visibility="{Binding LibrarySongs.Count, Converter={StaticResource CountToVis}}">
                                    <TextBlock Text="Songs" FontSize="24" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding LibrarySongs}" Margin="-8,0,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type m:Track}">
                                                <Button Margin="0,0,0,2" Cursor="Hand" Foreground="{StaticResource TextBrush}" HorizontalContentAlignment="Stretch"
                                                        Command="{Binding DataContext.PlayLibrarySongCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                        ToolTip="Play">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="8,6">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RaisedBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="44" />
                                                            <ColumnDefinition Width="5*" />
                                                            <ColumnDefinition Width="3*" />
                                                            <ColumnDefinition Width="56" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource RaisedBrush}" ClipToBounds="True">
                                                            <Grid>
                                                                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource FaintTextBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <Border CornerRadius="8" local:AsyncImage.BackgroundUrl="{Binding ImageUrl}" local:AsyncImage.Width="88" />
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Album}" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                                                        <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right" Margin="0,0,4,0" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>

                    <!-- Settings (Liner-style): sections of glass panels with one row per setting -->
                    <ScrollViewer x:Name="SettingsScroller" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" local:SmoothScroll.IsEnabled="True"
                                  Visibility="{Binding IsSettingsView, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="32,28,32,32" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="Settings" FontSize="40" FontWeight="Black" FontFamily="Segoe UI Black, Segoe UI" />
                            <TextBlock Text="Integrations, storage and what Yesify remembers" FontSize="14" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,6,0,0" />

                            <TextBlock Text="Integrations" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SubtleTextBrush}" Margin="4,30,0,10" />
                            <Border CornerRadius="16" Background="{DynamicResource GlassChipBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                <Grid Margin="20,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                        <TextBlock Text="Discord status" FontSize="14" FontWeight="Bold" />
                                        <TextBlock Text="Your Discord status shows the song, the artist, the album cover and how far into the song you are. It clears while paused." FontSize="12.5" LineHeight="18" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource SwitchBox}" IsChecked="{Binding ShowOnDiscord}" VerticalAlignment="Center" />
                                </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Background" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SubtleTextBrush}" Margin="4,30,0,10" />
                            <Border CornerRadius="16" Background="{DynamicResource GlassChipBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                <Grid Margin="20,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                        <TextBlock Text="Source" FontSize="14" FontWeight="Bold" />
                                        <TextBlock Text="The playing song's cover, blurred and tinted with its colors, or your own colors" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ChipButton}" Content="Album cover" Command="{Binding SetBackdropModeCommand}" CommandParameter="album"
                                                Tag="{Binding BackdropMode, Converter={StaticResource Equals}, ConverterParameter=album}" />
                                        <Button Style="{StaticResource ChipButton}" Content="Custom colors" Margin="6,0,0,0" Command="{Binding SetBackdropModeCommand}" CommandParameter="color"
                                                Tag="{Binding BackdropMode, Converter={StaticResource Equals}, ConverterParameter=color}" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="20,0" />
                                <Grid Margin="20,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                        <TextBlock Text="Tint" FontSize="14" FontWeight="Bold" />
                                        <TextBlock Text="How strongly the cover's own colors tint the background" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="100" Value="{Binding BackdropTint}"
                                            local:SliderDrag.WheelStep="5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding BackdropTint, StringFormat={}{0:0}%}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="20,0" />
                                <Grid Margin="20,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                        <TextBlock Text="Brightness" FontSize="14" FontWeight="Bold" />
                                        <TextBlock Text="Darker keeps text easiest to read; brighter shows more of the cover" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="100" Value="{Binding BackdropBrightness}"
                                            local:SliderDrag.WheelStep="5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding BackdropBrightness, StringFormat={}{0:0}%}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="20,0" />
                                <Grid Margin="20,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                        <TextBlock Text="Motion" FontSize="14" FontWeight="Bold" />
                                        <TextBlock Text="The background drifts slowly, like it's alive" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource SwitchBox}" IsChecked="{Binding BackdropMotion}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="20,0,20,16" IsEnabled="{Binding BackdropMotion}">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.4" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                        <TextBlock Text="Motion frame rate" FontSize="14" FontWeight="Bold" />
                                        <TextBlock Text="Lower saves power; higher is smoother" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="5" Maximum="120" Value="{Binding BackdropMotionFps}"
                                            local:SliderDrag.WheelStep="5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding BackdropMotionFps, StringFormat={}{0:0} FPS}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="20,0" />
                                <StackPanel Margin="20,16">
                                    <TextBlock Text="Custom colors" FontSize="14" FontWeight="Bold" />
                                    <TextBlock Text="Top-left to bottom-right, used with the Custom colors source. Pick a preset or type a hex color." FontSize="12.5"
                                               Foreground="{DynamicResource SubtleTextBrush}" Margin="0,3,0,12" TextWrapping="Wrap" />
                                    <WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                        <Border Width="34" Height="34" CornerRadius="10" Background="{Binding BackdropBrush1}" BorderBrush="#40FFFFFF" BorderThickness="1" />
                                        <TextBox Style="{StaticResource InputBox}" Width="104" Height="34" FontSize="13" Margin="8,0,0,0" Padding="12,0" Background="{DynamicResource GlassChipBrush}"
                                                 Text="{Binding BackdropColor1, UpdateSourceTrigger=PropertyChanged}" ToolTip="Hex color, like #3A2A8C" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                                        <Border Width="34" Height="34" CornerRadius="10" Background="{Binding BackdropBrush2}" BorderBrush="#40FFFFFF" BorderThickness="1" />
                                        <TextBox Style="{StaticResource InputBox}" Width="104" Height="34" FontSize="13" Margin="8,0,0,0" Padding="12,0" Background="{DynamicResource GlassChipBrush}"
                                                 Text="{Binding BackdropColor2, UpdateSourceTrigger=PropertyChanged}" ToolTip="Hex color, like #3A2A8C" />
                                    </StackPanel>
                                    </WrapPanel>
                                    <ItemsControl ItemsSource="{Binding BackdropPresets}" Margin="0,14,0,0" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="44" Height="44" Margin="0,0,8,8" Cursor="Hand" ToolTip="Use these colors"
                                                        Command="{Binding DataContext.SetBackdropPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" CornerRadius="12" BorderThickness="1.5" BorderBrush="#33FFFFFF" Background="{Binding Converter={StaticResource PresetBrush}}"
                                                                    RenderTransformOrigin="0.5,0.5">
                                                                <Border.RenderTransform>
                                                                    <ScaleTransform />
                                                                </Border.RenderTransform>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#E6FFFFFF" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Style="{StaticResource PillButton}" Content="Reset background" HorizontalAlignment="Left" Height="34" Padding="16,0" Margin="0,6,0,0"
                                            Background="{DynamicResource GlassChipBrush}" Command="{Binding ResetBackdropCommand}" />
                                </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Storage" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SubtleTextBrush}" Margin="4,30,0,10" />
                            <Border CornerRadius="16" Background="{DynamicResource GlassChipBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                <Grid Margin="20,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                        <TextBlock Text="Downloaded audio" FontSize="14" FontWeight="Bold" />
                                        <TextBlock FontSize="12.5" LineHeight="18" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"><Run Text="{Binding CacheSizeText, Mode=OneWay}" /><Run Text=" · keeps the songs you play most and the next one up" /></TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource PillButton}" Content="Clear" Height="34" Padding="18,0" Background="{DynamicResource GlassChipBrush}" VerticalAlignment="Center" Command="{Binding ClearAudioCacheCommand}" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="20,0" />
                                <Grid Margin="20,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                        <TextBlock Text="Keep up to" FontSize="14" FontWeight="Bold" />
                                        <TextBlock Text="More means more songs start instantly and work offline" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Slider Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="{Binding CacheStepMax, Mode=OneTime}" Value="{Binding CacheStep}"
                                            local:SliderDrag.WheelStep="1" VerticalAlignment="Center" ToolTip="Most songs to keep downloaded" />
                                    <TextBlock Grid.Column="2" Text="{Binding CacheLimitText}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="20,0" />
                                <Grid Margin="20,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                        <TextBlock Text="Listening history" FontSize="14" FontWeight="Bold" />
                                        <TextBlock Text="What you play, kept on this PC to pick Home's mixes and keep shuffle fresh" FontSize="12.5" LineHeight="18" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource PillButton}" Content="Clear" Height="34" Padding="18,0" Background="{DynamicResource GlassChipBrush}" VerticalAlignment="Center" Command="{Binding ClearListeningHistoryCommand}" />
                                </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="About" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SubtleTextBrush}" Margin="4,30,0,10" />
                            <Border CornerRadius="16" Background="{DynamicResource GlassChipBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                <Grid Margin="20,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                        <TextBlock Text="Yesify" FontSize="14" FontWeight="Bold" />
                                        <TextBlock Text="Playlists from Spotify&apos;s public pages, audio from YouTube, lyrics from LRCLIB. No account, no ads, unlimited skips." FontSize="12.5" LineHeight="18" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    
                                </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Search bar: fixed above the results (inside the list it would be rebuilt as results change) -->
                    <StackPanel Margin="32,28,32,0" Visibility="{Binding IsSearchView, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Search" FontSize="40" FontWeight="Black" FontFamily="Segoe UI Black, Segoe UI" />
                        <Grid Margin="0,14,0,0" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBox x:Name="LibrarySearchBox" Style="{StaticResource InputBox}" Width="560" Padding="40,0,14,0"
                                     Text="{Binding LibraryQuery, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="SearchBox_IsVisibleChanged" />
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource SubtleTextBrush}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="16,0,0,0" />
                            <TextBlock Text="What do you want to listen to?" Foreground="{DynamicResource FaintTextBrush}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="42,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Text, ElementName=LibrarySearchBox}" Value="" />
                                                            <Condition Binding="{Binding IsKeyboardFocused, ElementName=LibrarySearchBox}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <!-- Loading a page: glass placeholders for the header and songs, with a shine sweeping across.
                         Kept laid out (Hidden, not Collapsed) so it appears the instant a page is opened; shown and
                         cross-faded with the loaded page by MainWindow (see UpdateSkeleton). -->
                    <StackPanel x:Name="PageSkeleton" Grid.RowSpan="2" Margin="24,28,24,0" IsHitTestVisible="False" ClipToBounds="True"
                                Visibility="Hidden" Opacity="0">
                        <Grid Margin="0,0,0,22">
                            <local:GlassBlock Width="176" Height="176" HorizontalAlignment="Left" />
                            <StackPanel Margin="200,0,0,0" VerticalAlignment="Bottom">
                                <local:GlassBlock Width="340" Height="40" CornerRadius="10" HorizontalAlignment="Left" />
                                <local:GlassBlock Width="220" Height="12" CornerRadius="6" Margin="0,16,0,0" HorizontalAlignment="Left" />
                                <local:GlassBlock Width="440" Height="10" CornerRadius="5" Margin="0,14,0,0" HorizontalAlignment="Left" />
                                <local:GlassBlock Width="300" Height="10" CornerRadius="5" Margin="0,8,0,0" HorizontalAlignment="Left" />
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <local:GlassBlock Width="52" Height="52" CornerRadius="26" />
                                    <local:GlassBlock Width="36" Height="36" CornerRadius="18" Margin="16,0,0,0" />
                                    <local:GlassBlock Width="36" Height="36" CornerRadius="18" Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{x:Static local:Placeholders.Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="52" Margin="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="5*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <local:GlassBlock Width="12" Height="10" CornerRadius="3" />
                                        <local:GlassBlock Grid.Column="1" Width="40" Height="40" CornerRadius="5" HorizontalAlignment="Right" />
                                        <StackPanel Grid.Column="2" Margin="12,0,16,0" VerticalAlignment="Center">
                                            <local:GlassBlock Height="11" CornerRadius="5" HorizontalAlignment="Left"
                                                              Width="{Binding Converter={StaticResource SkeletonWidth}, ConverterParameter=230}" />
                                            <local:GlassBlock Height="9" CornerRadius="4" Margin="0,8,0,0" HorizontalAlignment="Left"
                                                              Width="{Binding Converter={StaticResource SkeletonWidth}, ConverterParameter=120}" />
                                        </StackPanel>
                                        <local:GlassBlock Grid.Column="3" Height="10" CornerRadius="5" HorizontalAlignment="Left"
                                                          Width="{Binding Converter={StaticResource SkeletonWidth}, ConverterParameter=150}" />
                                        <local:GlassBlock Grid.Column="5" Width="30" Height="10" CornerRadius="5" HorizontalAlignment="Right" Margin="0,0,4,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ListBox x:Name="TrackList" Grid.Row="1" Visibility="{Binding ShowTrackList, Converter={StaticResource BoolToVis}}" local:SmoothScroll.IsEnabled="True"
                             ContextMenuOpening="TrackList_ContextMenuOpening"
                             ItemContainerStyleSelector="{StaticResource TrackRows}"
                             Background="Transparent" BorderThickness="0" Padding="16,0,16,16"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.CacheLength="2" VirtualizingPanel.CacheLengthUnit="Page">
                        <ListBox.ContextMenu>
                            <ContextMenu /> <!-- filled in TrackList_ContextMenuOpening -->
                        </ListBox.ContextMenu>
                        <ListBox.Resources>
                            <!-- header -->
                            <DataTemplate DataType="{x:Type m:HeaderMarker}">
                                <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Margin="8,28,8,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="176" Height="176" CornerRadius="12" Margin="0,0,24,0"
                                            Background="{DynamicResource LikedTileBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                                            Visibility="{Binding ViewIsLikedHeader, Converter={StaticResource BoolToVis}}">
                                        <local:Icon Glyph="&#xEB52;" FontSize="66" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <local:Icon.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35" />
                                </local:Icon.Effect>
                            </local:Icon>
                                    </Border>
                                    <Border Width="176" Height="176" CornerRadius="12" Margin="0,0,24,0" ClipToBounds="True"
                                            Visibility="{Binding ViewImageUrl, Converter={StaticResource NullToVis}}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.5" />
                                        </Border.Effect>
                                        <!-- the shadow is drawn once and reused while the page scrolls -->
                                        <Border.CacheMode>
                                            <BitmapCache EnableClearType="False" />
                                        </Border.CacheMode>
                                        <Image local:AsyncImage.Url="{Binding ViewImageUrl}" local:AsyncImage.Width="360" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                        <TextBlock FontSize="44" FontWeight="Black" FontFamily="Segoe UI Black, Segoe UI" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding ViewTitle, Converter={StaticResource NullToVis}}">
                                            <Run Text="{Binding ViewTitle, Mode=OneWay}" />
                                            <!-- not found on YouTube Music: only your saved songs are listed -->
                                            <InlineUIContainer BaselineAlignment="Center">
                                                <Border Width="28" Height="28" CornerRadius="14" BorderBrush="White" BorderThickness="2.5" Margin="10,0,0,4"
                                                        Background="Transparent" Cursor="Help" ToolTipService.InitialShowDelay="150"
                                                        ToolTip="Couldn't fetch this album from YouTube Music, so only the songs you saved from it are shown."
                                                        Visibility="{Binding ViewNotFound, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="!" FontSize="17" FontWeight="Black" FontFamily="Segoe UI" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                                                </Border>
                                            </InlineUIContainer>
                                        </TextBlock>

                                        <TextBlock Text="{Binding ViewSubtitleLine}" Margin="0,6,0,0" FontSize="16" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"
                                                   Visibility="{Binding ViewSubtitleLine, Converter={StaticResource NullToVis}}" />
                                        <!-- stats as Liner-style badges: year · tracks · length -->
                                        <WrapPanel Margin="0,10,0,-6">
                                            <Border Margin="0,0,6,6" Padding="10,4,11,5" CornerRadius="9" Background="{DynamicResource GlassChipBrush}"
                                                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                                                    Visibility="{Binding ViewMetaYear, Converter={StaticResource NullToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ViewMetaYear}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <Border Margin="0,0,6,6" Padding="10,4,11,5" CornerRadius="9" Background="{DynamicResource GlassChipBrush}"
                                                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                                                    Visibility="{Binding ViewMetaTracks, Converter={StaticResource NullToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <local:Icon Glyph="&#xEC4F;" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
                                                    <TextBlock Text="{Binding ViewMetaTracks}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <Border Margin="0,0,6,6" Padding="10,4,11,5" CornerRadius="9" Background="{DynamicResource GlassChipBrush}"
                                                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                                                    Visibility="{Binding ViewMetaDuration, Converter={StaticResource NullToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <local:Icon Glyph="&#xE916;" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
                                                    <TextBlock Text="{Binding ViewMetaDuration}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding ViewDescription}" Margin="0,8,0,0" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"
                                                   MaxWidth="560" HorizontalAlignment="Left" Visibility="{Binding ViewDescription, Converter={StaticResource NullToVis}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button Style="{StaticResource AccentPillButton}" Command="{Binding PlayAllCommand}" ToolTip="Play" Margin="0,0,8,0" Height="40" Padding="18,0,22,0" FontSize="14"
                                                    Visibility="{Binding HasTracks, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <local:Icon Glyph="&#xF5B0;" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="Play all" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GlassIconButton}" Content="&#xE8B1;" Command="{Binding ShuffleAllCommand}" ToolTip="Shuffle play"
                                                    Visibility="{Binding HasTracks, Converter={StaticResource BoolToVis}}" />
                                            <Button Margin="8,0,0,0" Command="{Binding ToggleSaveCurrentCommand}"
                                                    Visibility="{Binding CurrentCollection, Converter={StaticResource NullToVis}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GlassIconButton}">
                                                        <Setter Property="Content" Value="&#xE710;" />
                                                        <Setter Property="ToolTip" Value="Add to Library" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrentSaved}" Value="True">
                                                                <Setter Property="Content" Value="&#xE73E;" />
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                <Setter Property="ToolTip" Value="In your Library. Click to remove" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Style="{StaticResource GlassIconButton}" Content="&#xE712;" Margin="8,0,0,0"
                                                    ToolTip="More" Click="HeaderMore_Click" Visibility="{Binding HasTracks, Converter={StaticResource BoolToVis}}" />
                                            <Button Style="{StaticResource PillButton}" Margin="8,0,0,0" Padding="16,0" Height="40" Background="{DynamicResource GlassChipBrush}" Command="{Binding StartViewRadioCommand}"
                                                    ToolTip="Endless radio from this artist's songs" Visibility="{Binding HasViewRadio, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE93E;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="Mix" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <local:LoadingDots Margin="16,0,0,0" DotSize="7" Fill="{DynamicResource SubtleTextBrush}" ToolTip="Loading"
                                                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>

                            <!-- Rows above the songs (search: artists), then the songs' label ("Top songs") -->
                            <DataTemplate DataType="{x:Type m:TopSectionsMarker}">
                                <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Margin="8,0,8,0">
                                    <ItemsControl ItemsSource="{Binding ViewTopSections}" ItemTemplate="{StaticResource SectionTemplate}" Margin="0,-18,0,8" />
                                    <TextBlock Text="{Binding ViewSongsTitle}" FontSize="22" FontWeight="Bold" Margin="0,8,0,8"
                                               Visibility="{Binding ViewSongsTitle, Converter={StaticResource NullToVis}}" />
                                    <!-- the songs are on their way (the header is already shown) -->
                                    <ItemsControl ItemsSource="{x:Static local:Placeholders.Rows}" IsHitTestVisible="False" Margin="8,0,8,0"
                                                  Visibility="{Binding IsLoadingSongs, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="52" Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="48" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <local:GlassBlock Width="12" Height="10" CornerRadius="3" />
                                                    <local:GlassBlock Grid.Column="1" Width="40" Height="40" CornerRadius="8" HorizontalAlignment="Right" />
                                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <local:GlassBlock Width="{Binding Converter={StaticResource SkeletonWidth}, ConverterParameter=240}" Height="11" CornerRadius="5" HorizontalAlignment="Left" />
                                                        <local:GlassBlock Width="{Binding Converter={StaticResource SkeletonWidth}, ConverterParameter=140}" Height="9" CornerRadius="4" Margin="0,8,0,0" HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>

                            <!-- Rows under the songs: an artist's albums, singles, videos, similar artists...; search's albums and playlists -->
                            <DataTemplate DataType="{x:Type m:SectionsMarker}">
                                <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Margin="8,0,8,24">
                                    <Button Style="{StaticResource PillButton}" Content="See all songs" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="14,6"
                                            Command="{Binding SeeAllSongsCommand}" Visibility="{Binding ViewAllSongsId, Converter={StaticResource NullToVis}}" />
                                    <ItemsControl ItemsSource="{Binding ViewSections}" ItemTemplate="{StaticResource SectionTemplate}" />
                                </StackPanel>
                            </DataTemplate>

                            <!-- Search: divider between your library's matches and the songs found beyond it -->
                            <DataTemplate DataType="{x:Type m:SearchMoreMarker}">
                                <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Margin="8,26,8,10"
                                            Visibility="{Binding ShowSearchOnlineSection, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="More songs" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                                        <local:LoadingDots Margin="14,3,0,0" DotSize="6" Fill="{DynamicResource SubtleTextBrush}"
                                                           Visibility="{Binding IsSearchingOnline, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Text="Picked for you and from YouTube Music" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding SearchOnlineStatus}" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,12,0,0"
                                               Visibility="{Binding SearchOnlineStatus, Converter={StaticResource NullToVis}}" />
                                </StackPanel>
                            </DataTemplate>

                            <!-- song row -->
                            <DataTemplate DataType="{x:Type m:Track}">
                                <Grid x:Name="Row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="5*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Num" Text="{Binding Number}" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <!-- hovering a row turns its number into a play button -->
                                    <Button x:Name="PlayHint" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="13" Width="28" Height="28" Visibility="Collapsed"
                                            Foreground="{StaticResource TextBrush}" ToolTip="Play"
                                            Command="{Binding DataContext.PlayFromCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource RaisedBrush}" ClipToBounds="True" HorizontalAlignment="Right">
                                        <Grid>
                                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource FaintTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image local:AsyncImage.Url="{Binding ImageUrl}" local:AsyncImage.Width="80" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <!-- a Grid cell (not a horizontal StackPanel) so long titles end in "…" instead of running under the next column -->
                                    <StackPanel Grid.Column="2" Margin="12,0,16,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        <DockPanel Margin="0,2,0,0">
                                            <Border x:Name="Explicit" DockPanel.Dock="Left" Visibility="Collapsed" Width="14" Height="14" CornerRadius="2.5" Margin="0,0,6,0"
                                                    Background="{DynamicResource InactiveIconBrush}" VerticalAlignment="Center" ToolTip="Explicit">
                                                <TextBlock Text="E" FontSize="9" FontWeight="Bold" Foreground="#FF101016" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"
                                                       Style="{StaticResource LinkText}" HorizontalAlignment="Left" MouseLeftButtonUp="ArtistLink_Click" ToolTip="Go to artist" />
                                        </DockPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Album}" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0"
                                               Style="{StaticResource LinkText}" HorizontalAlignment="Left" MouseLeftButtonUp="AlbumLink_Click" ToolTip="Go to album" />
                                    <Button Grid.Column="4" Style="{StaticResource HeartButton}" Command="{Binding DataContext.ToggleLikeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    <TextBlock Grid.Column="5" Text="{Binding DurationText}" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                        <Setter TargetName="Row" Property="Opacity" Value="0.42" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsExplicit}" Value="True">
                                        <Setter TargetName="Explicit" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource SameObject}">
                                                <Binding />
                                                <Binding Path="DataContext.CurrentTrack" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="Num" Property="FontFamily" Value="{StaticResource IconFont}" />
                                        <Setter TargetName="Num" Property="Text" Value="&#xE995;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="Num" Property="Visibility" Value="Hidden" />
                                        <Setter TargetName="PlayHint" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>
                    </Grid>
                </Border>

                <!-- drag to resize the right panel -->
                <GridSplitter x:Name="RightSplitter" Grid.Column="2" Width="8" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                              Background="Transparent" Cursor="SizeWE" DragCompleted="RightSplitter_DragCompleted" Visibility="Collapsed" />

                <!-- right panel: lyrics / queue -->
                <!-- shown, hidden and slid in / out by MainWindow.UpdateRightPanel -->
                <Border x:Name="RightPanel" Grid.Column="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="16"
                        Visibility="Collapsed" HorizontalAlignment="Left">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- (Lyrics / Queue are switched with the player bar's buttons) -->
                        <Border Height="8" />

                        <!-- lyrics -->
                        <Grid x:Name="LyricsPane" Grid.Row="1" Visibility="{Binding ShowLyrics, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding LyricsStatus}" Foreground="{DynamicResource SubtleTextBrush}" Margin="20,8" TextWrapping="Wrap" />
                            <local:LoadingDots DotSize="9" Fill="{DynamicResource SubtleTextBrush}" Margin="24,16,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                               ToolTip="Loading lyrics" Visibility="{Binding IsLyricsLoading, Converter={StaticResource BoolToVis}}" />
                            <ScrollViewer x:Name="LyricsScroller" VerticalScrollBarVisibility="Hidden">
                                <!-- note: scrolled by LyricsAnimator with an eased animation -->
                                <!-- Each line is its words (lit by a gradient sweep, see LyricsAnimator) or, for an
                                     instrumental break, three dots that fill up. -->
                                <ItemsControl x:Name="LyricsList" ItemsSource="{Binding Lyrics}" Margin="22,8,22,240"
                                              TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Animated" TextOptions.TextRenderingMode="Grayscale">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type m:LyricLine}">
                                            <Grid x:Name="LineRoot" Margin="0,9" Cursor="Hand" MouseLeftButtonUp="Lyric_Click" RenderTransformOrigin="0,0.5">
                                                <Grid.RenderTransform>
                                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                                </Grid.RenderTransform>
                                                <ItemsControl ItemsSource="{Binding Words}" Focusable="False"
                                                              Visibility="{Binding IsBreak, Converter={StaticResource InvBoolToVis}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type m:LyricWord}">
                                                            <TextBlock Text="{Binding Text}" FontSize="27" FontWeight="ExtraBold" FontFamily="Segoe UI Variable Display, Segoe UI" Loaded="LyricWord_Loaded" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Orientation="Horizontal" Height="40" RenderTransformOrigin="0,0.5"
                                                            Visibility="{Binding IsBreak, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel.RenderTransform>
                                                        <ScaleTransform />
                                                    </StackPanel.RenderTransform>
                                                    <Ellipse Width="11" Height="11" Fill="White" Opacity="0.3" Margin="2,0,7,0" VerticalAlignment="Center" />
                                                    <Ellipse Width="11" Height="11" Fill="White" Opacity="0.3" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                    <Ellipse Width="11" Height="11" Fill="White" Opacity="0.3" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- queue -->
                        <ScrollViewer x:Name="QueueScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" local:SmoothScroll.IsEnabled="True" Visibility="{Binding ShowQueue, Converter={StaticResource BoolToVis}}">
                            <StackPanel x:Name="QueueContent" Margin="10,0,10,16">
                                <!-- Recently played sits above Now playing: scroll up to see it. -->
                                <StackPanel x:Name="HistorySection" Visibility="{Binding HistoryView.Count, Converter={StaticResource CountToVis}}">
                                    <TextBlock Text="RECENTLY PLAYED" Style="{StaticResource SectionLabel}" Margin="6,10,0,8" />
                                    <ItemsControl x:Name="HistoryList" ItemsSource="{Binding HistoryView}" ItemTemplate="{StaticResource QueueRow}"
                                                  MouseLeftButtonUp="HistoryList_MouseUp" />
                                </StackPanel>

                                <!-- Now playing is scrolled to the top of the panel by default. -->
                                <StackPanel x:Name="NowPlayingBlock">
                                    <TextBlock Text="NOW PLAYING" Style="{StaticResource SectionLabel}" Margin="6,10,0,8" />
                                    <Grid Margin="6,0" Background="Transparent" Visibility="{Binding CurrentTrack, Converter={StaticResource NullToVis}}"
                                          ContextMenuOpening="NowPlaying_ContextMenuOpening">
                                        <Grid.ContextMenu>
                                            <ContextMenu /> <!-- filled in NowPlaying_ContextMenuOpening -->
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="4" Background="{DynamicResource RaisedBrush}" ClipToBounds="True">
                                            <Image local:AsyncImage.Url="{Binding CurrentTrack.ImageUrl}" local:AsyncImage.Width="80" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentTrack.Title}" FontSize="13" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CurrentTrack.Artist}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="UP NEXT" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="Nothing queued. Right-click a song → Play next or Add to queue." FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource FaintTextBrush}" Margin="6,0"
                                           Visibility="{Binding UpNextView.Count, Converter={StaticResource ZeroToVis}}" />
                                <ItemsControl x:Name="UpNextList" ItemsSource="{Binding UpNextView}" ItemTemplate="{StaticResource QueueRow}"
                                              PreviewMouseLeftButtonDown="UpNext_MouseDown" PreviewMouseMove="UpNext_MouseMove"
                                              PreviewMouseLeftButtonUp="UpNext_MouseUp" LostMouseCapture="UpNext_LostCapture" />
                                <Button Content="Show more" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Margin="6,8,0,0" Padding="14,6"
                                        Command="{Binding ShowMoreQueueCommand}"
                                        Visibility="{Binding HasMoreUpNext, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================================ player bar -->
            <Border Grid.Row="2" Margin="8" CornerRadius="16" Background="{DynamicResource PlayerBarBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
            <Grid Margin="10,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="220" />
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="3*" MinWidth="240" />
                </Grid.ColumnDefinitions>

                <!-- now playing -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent"
                            Visibility="{Binding CurrentTrack, Converter={StaticResource NullToVis}}"
                            ContextMenuOpening="NowPlaying_ContextMenuOpening">
                    <StackPanel.ContextMenu>
                        <ContextMenu /> <!-- filled in NowPlaying_ContextMenuOpening -->
                    </StackPanel.ContextMenu>
                    <Border Width="56" Height="56" CornerRadius="10" Background="{DynamicResource RaisedBrush}" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource FaintTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image local:AsyncImage.Url="{Binding CurrentTrack.ImageUrl}" local:AsyncImage.Width="112" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" MaxWidth="260">
                        <TextBlock Text="{Binding CurrentTrack.Title}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"
                                   Style="{StaticResource LinkText}" MouseLeftButtonUp="AlbumLink_Click" ToolTip="Go to album" />
                        <TextBlock Text="{Binding CurrentTrack.Artist}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                   HorizontalAlignment="Left" Style="{StaticResource LinkText}" MouseLeftButtonUp="ArtistLink_Click" ToolTip="Go to artist" />
                    </StackPanel>
                    <Button Style="{StaticResource HeartButton}" DataContext="{Binding CurrentTrack}" Margin="10,0,0,0" VerticalAlignment="Center"
                            Command="{Binding DataContext.ToggleLikeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </StackPanel>

                <!-- transport -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="640">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE8B1;" Command="{Binding ToggleShuffleCommand}" ToolTip="Shuffle (songs you haven't heard lately come first)"
                                Foreground="{Binding Shuffle, Converter={StaticResource ActiveBrush}}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="17" Command="{Binding PreviousCommand}" Margin="8,0,0,0" ToolTip="Previous" />
                        <Grid Margin="12,0">
                            <Button Style="{StaticResource PlayButton}" Content="{Binding IsPlaying, Converter={StaticResource PlayGlyph}}" Command="{Binding TogglePlayCommand}" ToolTip="Play / Pause" />
                            <!-- Loading ring. The animation only exists while a song is loading: WPF keeps ticking
                                 "Forever" animations even on hidden elements, which costs CPU for nothing. -->
                            <!-- Loading: a comet of light sweeping round the play button, gently breathing.
                                 Only animates while a song is loading (Forever animations on hidden elements still cost CPU). -->
                            <Ellipse Width="50" Height="50" Style="{StaticResource LoadingRing}">
                                <Ellipse.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform />
                                        <ScaleTransform />
                                    </TransformGroup>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="17" Command="{Binding NextCommand}" Margin="0,0,8,0" ToolTip="Next (unlimited)" />
                        <Button Style="{StaticResource IconButton}" Content="{Binding Repeat, Converter={StaticResource RepeatGlyph}}" Command="{Binding CycleRepeatCommand}" ToolTip="Repeat"
                                Foreground="{Binding Repeat, Converter={StaticResource ActiveBrush}}" />
                    </StackPanel>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PositionText}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                        <Slider x:Name="SeekBar" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0"
                                Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}"
                                PreviewMouseLeftButtonDown="SeekBar_MouseDown" PreviewMouseLeftButtonUp="SeekBar_MouseUp" />
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>

                <!-- right side: a glass segmented group (lyrics, queue, cinema, miniplayer), then a volume pill -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Padding="3" CornerRadius="12" Background="{DynamicResource GlassChipBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BarButton}" Content="&#xE8BD;" Command="{Binding ToggleLyricsCommand}" ToolTip="Lyrics" Tag="{Binding ShowLyrics}" />
                            <Button Style="{StaticResource BarButton}" Content="&#xE8FD;" Command="{Binding ToggleQueueCommand}" ToolTip="Queue" Margin="2,0,0,0" Tag="{Binding ShowQueue}" />
                            <Button Style="{StaticResource BarButton}" Content="&#xE7F4;" Command="{Binding ToggleCinemaCommand}" ToolTip="Cinema: full-window cover and lyrics (Esc to leave)" Margin="2,0,0,0"
                                    Tag="{Binding IsCinema}" />
                            <Button Style="{StaticResource BarButton}" Content="mini" ContentTemplate="{StaticResource MiniPlayerGlyph}" Command="{Binding OpenMiniPlayerCommand}" ToolTip="Open miniplayer" Margin="2,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Margin="8,0,0,0" Height="40" Padding="12,0,14,0" CornerRadius="12" Background="{DynamicResource GlassChipBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="14" Margin="-6,0,4,0" VerticalAlignment="Center"
                                    Content="{Binding Volume, Converter={StaticResource VolumeGlyph}}" Command="{Binding ToggleMuteCommand}" ToolTip="Mute / unmute" />
                            <Slider Style="{StaticResource ThinSlider}" Width="92" Minimum="0" Maximum="1" Value="{Binding Volume}" VerticalAlignment="Center"
                                    local:SliderDrag.WheelStep="0.05" ToolTip="{Binding Volume, Converter={StaticResource Percent}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            </Border>

            <!-- status toast -->
            <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Padding="16,10" CornerRadius="8"
                    Background="{DynamicResource ToastBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" MaxWidth="640" Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}"
                    MouseLeftButtonUp="Status_Click" Cursor="Hand">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="10" To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="13" />
            </Border>
        </Grid>

        <!-- ============================================================ cinema
             The whole window: big cover with the song under it on the left, big lyrics on the right that
             fade into the backdrop at the top and bottom. Shown and hidden by MainWindow.UpdateCinema. -->
        <Grid x:Name="Cinema" Visibility="Collapsed" Opacity="0" Background="Transparent" MouseMove="Cinema_MouseMove">
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#33000000" Offset="0" />
                        <GradientStop Color="#59000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- top: leave, and the window buttons. Laid out exactly like the normal title bar (a 46 px row,
                 the same margins); they fade away when the mouse rests and come back when it moves. -->
            <Grid x:Name="CinemaChrome" Height="46" VerticalAlignment="Top" Panel.ZIndex="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                <!-- cinema's own bubble: full screen, and leave -->
                <Border Padding="3" CornerRadius="11" Margin="0,0,8,0"
                        Background="{DynamicResource GlassChipBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CinemaFullButton" Style="{StaticResource CaptionButton}" Content="&#xE740;" Click="CinemaFullscreen_Click" ToolTip="Full screen (F11)" />
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE70D;" Command="{Binding ToggleCinemaCommand}" ToolTip="Leave cinema (Esc)" />
                    </StackPanel>
                </Border>
                <Border Padding="3" CornerRadius="11"
                        Background="{DynamicResource GlassChipBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
                        <Button x:Name="CinemaMaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize" />
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close (keeps playing in the tray)" />
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>

            <Grid Margin="56,56,40,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="6*" />
                </Grid.ColumnDefinitions>

                <!-- the song: scales down as a whole when the window is small -->
                <Viewbox StretchDirection="DownOnly" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,40,0">
                    <StackPanel Width="420">
                        <Border Width="420" Height="420" CornerRadius="18" Background="{DynamicResource RaisedBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="60" ShadowDepth="14" Opacity="0.55" />
                            </Border.Effect>
                            <Border CornerRadius="18" local:AsyncImage.BackgroundUrl="{Binding CurrentTrack.ImageUrl}" local:AsyncImage.Width="840" />
                        </Border>
                        <Grid Margin="0,26,0,0">
                            <StackPanel Margin="0,0,48,0">
                                <TextBlock Text="{Binding CurrentTrack.Title}" FontSize="26" FontWeight="Black" FontFamily="Segoe UI Black, Segoe UI" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding CurrentTrack.Title}" />
                                <TextBlock Text="{Binding CurrentTrack.Artist}" FontSize="17" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" DataContext="{Binding CurrentTrack}"
                                    Command="{Binding DataContext.ToggleLikeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GlassIconButton}">
                                        <Setter Property="Content" Value="&#xEB51;" />
                                        <Setter Property="ToolTip" Value="Add to Liked Songs" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                                <Setter Property="Content" Value="&#xEB52;" />
                                                <Setter Property="ToolTip" Value="Remove from Liked Songs" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <Slider Style="{StaticResource ThinSlider}" Margin="0,22,0,0" Minimum="0"
                                Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}"
                                PreviewMouseLeftButtonDown="SeekBar_MouseDown" PreviewMouseLeftButtonUp="SeekBar_MouseUp" />
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="{Binding PositionText}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" />
                            <TextBlock Text="{Binding DurationText}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Style="{StaticResource IconButton}" Content="&#xE8B1;" FontSize="18" Width="44" Height="44" Command="{Binding ToggleShuffleCommand}" ToolTip="Shuffle"
                                    Foreground="{Binding Shuffle, Converter={StaticResource ActiveBrush}}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="22" Width="52" Height="52" Margin="14,0,0,0" Command="{Binding PreviousCommand}" ToolTip="Previous"
                                    Foreground="{StaticResource TextBrush}" />
                            <Grid Margin="18,0">
                                <Button Style="{StaticResource PlayButton}" Content="{Binding IsPlaying, Converter={StaticResource PlayGlyph}}" Width="64" Height="64" FontSize="24"
                                        Command="{Binding TogglePlayCommand}" ToolTip="Play / Pause" />
                                <Ellipse Width="74" Height="74" StrokeThickness="3.5" Style="{StaticResource LoadingRing}">
                                    <Ellipse.RenderTransform>
                                        <TransformGroup>
                                            <RotateTransform />
                                            <ScaleTransform />
                                        </TransformGroup>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="22" Width="52" Height="52" Margin="0,0,14,0" Command="{Binding NextCommand}" ToolTip="Next"
                                    Foreground="{StaticResource TextBrush}" />
                            <Button Style="{StaticResource IconButton}" Content="{Binding Repeat, Converter={StaticResource RepeatGlyph}}" FontSize="18" Width="44" Height="44"
                                    Command="{Binding CycleRepeatCommand}" ToolTip="Repeat" Foreground="{Binding Repeat, Converter={StaticResource ActiveBrush}}" />
                        </StackPanel>
                    </StackPanel>
                </Viewbox>

                <!-- the lyrics: big, left-aligned, fading out toward the top and bottom edges -->
                <Grid Grid.Column="1">
                    <TextBlock Text="{Binding LyricsStatus}" FontSize="22" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <ScrollViewer x:Name="CinemaLyricsScroller" VerticalScrollBarVisibility="Hidden">
                        <ScrollViewer.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#FF000000" Offset="0.07" />
                                <GradientStop Color="#FF000000" Offset="0.86" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </LinearGradientBrush>
                        </ScrollViewer.OpacityMask>
                        <ItemsControl x:Name="CinemaLyricsList" ItemsSource="{Binding Lyrics}" Margin="0,320,24,420"
                                      TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Animated" TextOptions.TextRenderingMode="Grayscale">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:LyricLine}">
                                    <Grid x:Name="LineRoot" Margin="0,14" Cursor="Hand" MouseLeftButtonUp="Lyric_Click" RenderTransformOrigin="0,0.5">
                                        <Grid.RenderTransform>
                                            <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                        </Grid.RenderTransform>
                                        <ItemsControl ItemsSource="{Binding Words}" Focusable="False"
                                                      Visibility="{Binding IsBreak, Converter={StaticResource InvBoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type m:LyricWord}">
                                                    <TextBlock Text="{Binding Text}" FontSize="40" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI" Loaded="LyricWord_Loaded" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Height="56" RenderTransformOrigin="0,0.5"
                                                    Visibility="{Binding IsBreak, Converter={StaticResource BoolToVis}}">
                                            <StackPanel.RenderTransform>
                                                <ScaleTransform />
                                            </StackPanel.RenderTransform>
                                            <Ellipse Width="16" Height="16" Fill="White" Opacity="0.3" Margin="2,0,10,0" VerticalAlignment="Center" />
                                            <Ellipse Width="16" Height="16" Fill="White" Opacity="0.3" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <Ellipse Width="16" Height="16" Fill="White" Opacity="0.3" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================================================ playlist editor (Apple Music-style) -->
        <Grid Background="#80000000" Visibility="{Binding IsEditingPlaylist, Converter={StaticResource BoolToVis}}"
              MouseLeftButtonDown="EditorBackdrop_MouseDown">
            <Grid Width="600" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border local:Frost.Enabled="True" CornerRadius="14" />
            <Border CornerRadius="14" Padding="26"
                    Background="{DynamicResource SettingsCardBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                    MouseLeftButtonDown="SettingsCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- cover: click to pick an image -->
                    <Grid x:Name="EditorCover" Width="200" Height="200" Cursor="Hand" MouseLeftButtonUp="EditorCover_Click" ToolTip="Choose an image">
                        <Border CornerRadius="10" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="52" Foreground="{DynamicResource FaintTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="10" local:AsyncImage.BackgroundUrl="{Binding EditCoverPreview}" local:AsyncImage.Width="400" />
                        <Border CornerRadius="10" Background="#99000000">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=EditorCover}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="22" HorizontalAlignment="Center" />
                                <TextBlock Text="Choose Image" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="22,0,0,0">
                        <Grid>
                            <TextBox x:Name="EditorTitle" Style="{StaticResource FieldBox}" FontSize="22" FontWeight="Bold" Padding="10,8"
                                     Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenShown">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SavePlaylistCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="Playlist Title" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource FaintTextBrush}" Margin="13,9,0,0"
                                       IsHitTestVisible="False" Visibility="{Binding EditTitle, Converter={StaticResource InvNullToVis}}" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding EditAuthor, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Author (optional)" Foreground="{DynamicResource FaintTextBrush}" Margin="13,9,0,0" FontSize="14"
                                       IsHitTestVisible="False" Visibility="{Binding EditAuthor, Converter={StaticResource InvNullToVis}}" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <TextBox Style="{StaticResource FieldBox}" Height="86" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Description (optional)" Foreground="{DynamicResource FaintTextBrush}" Margin="13,9,0,0" FontSize="14"
                                       IsHitTestVisible="False" Visibility="{Binding EditDescription, Converter={StaticResource InvNullToVis}}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Style="{StaticResource PillButton}" Content="Cancel" Command="{Binding CancelEditPlaylistCommand}" Margin="0,0,10,0" />
                        <Button Command="{Binding SavePlaylistCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentPillButton}">
                                    <Setter Property="Content" Value="Save" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EditIsNew}" Value="True">
                                            <Setter Property="Content" Value="Create" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>
        </Grid>

        <!-- ============================================================ import playlist -->
        <Grid Background="#80000000" Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}"
              MouseLeftButtonDown="ImportBackdrop_MouseDown">
            <Grid Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border local:Frost.Enabled="True" CornerRadius="14" />
            <Border CornerRadius="14" Padding="26,22,26,24"
                    Background="{DynamicResource SettingsCardBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                    MouseLeftButtonDown="SettingsCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Import Playlist" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Paste a link to a Spotify playlist or album, or a YouTube playlist. It's added to your library."
                               TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,8,0,16" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenShown">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ConfirmImportCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding CancelImportCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource PillButton}" Content="Cancel" Command="{Binding CancelImportCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource AccentPillButton}" Content="Import" Command="{Binding ConfirmImportCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            </Grid>
        </Grid>

    </Grid>
</Window>
